# Installed inside the image, never copied in.
node_modules
**/node_modules

# Build output, regenerated by the image.
**/.next
**/*.tsbuildinfo
packages/server/src/generated

# Secrets. These are gitignored too, so a Coolify clone has none of them, but a
# local `docker build` would otherwise bake a real .env into a layer.
.env
**/.env
**/.env.*

.git
.github
