{
  "name": "ksamods-web",
  "private": true,
  "version": "0.1.0",
  "description": "Tailwind build and font sync for the ksamods.gg Blazor frontend",
  "scripts": {
    "build:css": "tailwindcss -i ./Styles/app.css -o ./wwwroot/app.css --minify",
    "watch:css": "tailwindcss -i ./Styles/app.css -o ./wwwroot/app.css --watch",
    "sync:fonts": "node sync-fonts.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@tailwindcss/cli": "^4.1.11",
    "tailwindcss": "^4.1.11"
  }
}
