<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      Static-asset precompression is off.

      The SDK writes the compressed companions into obj/.../compressed/ with a literal "{0}"
      still in the filename, so at runtime MapStaticAssets advertises a gzip/br variant, fails to
      find it, and answers a browser's Accept-Encoding request with an empty 200 body. Stylesheets
      then parse to zero rules and blazor.web.js aborts - with no error anywhere, because the
      status is 200 and curl (which sends no Accept-Encoding) sees the correct file.

      Fingerprinting and long-lived caching still work; only the precompressed variants are
      dropped. Compression belongs at the CDN or reverse proxy in front of this anyway.
    -->
    <CompressionEnabled>false</CompressionEnabled>
    <StaticWebAssetsCompressionEnabled>false</StaticWebAssetsCompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KsaMods.Metadata\KsaMods.Metadata.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <!--
    Tailwind is built before compile so wwwroot/app.css is never stale in a fresh clone.

    That promise used to be defeated by the flag meant to keep the build convenient. With
    ContinueOnError="true" a missing node_modules, a syntax error in app.css, or an npm that is not
    on PATH all failed silently, MSBuild carried on, and the app served whatever app.css happened
    to be committed. The failure mode was the exact one this target exists to prevent, and it was
    invisible: a green build serving stale CSS.

    So the Exec now fails the build, and says which of the two likely causes it was. Pass
    -p:SkipTailwind=true to opt out deliberately - a container build that has already run the CSS
    step, for instance - which is a decision someone makes rather than one a missing tool makes
    for them.
  -->
  <Target Name="BuildTailwind" BeforeTargets="BeforeBuild" Condition="'$(SkipTailwind)' != 'true'">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/node_modules')" Text="Tailwind cannot run: node_modules is missing. Run 'npm install' in $(MSBuildProjectDirectory), or build with -p:SkipTailwind=true to serve the committed wwwroot/app.css as-is." />

    <Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" />

    <Error Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/app.css')" Text="Tailwind reported success but wwwroot/app.css does not exist." />
  </Target>

</Project>
