@namespace KsaMods.Web.Components.Domain
@rendermode InteractiveServer
@using KsaMods.Web.Components.Ui
@inject KsaModsApi Api
@inject NavigationManager Nav

@*
    Reporting something, from wherever it is.

    Deliberately quiet: a small text link rather than a button sitting next to Download. Almost
    nobody needs it, and a page that offers "report" as prominently as "install" reads as though
    the site expects its own catalogue to be dangerous.

    Takes a subject kind and id rather than a mod, so a release page or a profile can use the same
    component without this knowing anything about them.
*@

@if (_sent)
{
    <p class="text-xs text-severity-ok">Reported. A moderator will look at it.</p>
}
else if (!_open)
{
    <button type="button" @onclick="OpenAsync"
            class="rounded-sm text-xs text-muted-foreground underline-offset-4 transition-colors
                   hover:text-foreground hover:underline focus-visible:outline-2
                   focus-visible:outline-offset-2 focus-visible:outline-ring">
        Report this @Noun
    </button>
}
else
{
    <div class="rounded-lg border border-border bg-card p-4">
        <h3 class="text-sm font-semibold">Report this @Noun</h3>
        <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
            This goes to the moderators, not to the author. For something broken, telling the
            author on their own repository is usually faster.
        </p>

        @if (_error is not null)
        {
            <Alert Variant="error" Title="That didn't send" Class="mt-3">@_error</Alert>
        }

        <div class="mt-3 space-y-3">
            <Field Context="field" Id="reportCategory" Label="Reason">
                <select @attributes="field" @bind="_category" class="@InputClass">
                    <option value="malware">Malware or something harmful</option>
                    <option value="stolen">Somebody else's work</option>
                    <option value="broken">Broken or does not install</option>
                    <option value="other">Something else</option>
                </select>
            </Field>

            <Field Context="field" Id="reportBody" Label="What happened" Required="false"
                   Hint="Anything that would help somebody check this quickly. Links and version numbers help most.">
                <textarea @attributes="field" @bind="_body" rows="3" class="@InputClass"></textarea>
            </Field>
        </div>

        <div class="mt-4 flex items-center gap-3">
            <Button Size="sm" Disabled="_sending" Pending="_sending" PendingLabel="Sending…"
                    @onclick="SubmitAsync">
                Send report
            </Button>
            <Button Size="sm" Variant="ghost" Disabled="_sending" @onclick="() => _open = false">
                Cancel
            </Button>
        </div>
    </div>
}

@code {
    /// <summary>mod, release, modlist or account. Matches report.subject_kind.</summary>
    [Parameter, EditorRequired] public string SubjectKind { get; set; } = "mod";

    [Parameter, EditorRequired] public string SubjectId { get; set; } = "";

    /// <summary>What to call it in the copy. "mod" reads better than "subject".</summary>
    [Parameter] public string Noun { get; set; } = "mod";

    private bool _open;
    private bool _sent;
    private bool _sending;
    private string _category = "malware";
    private string _body = "";
    private string? _error;

    private const string InputClass =
        "w-full rounded-md border border-input bg-background px-3 py-2 text-sm " +
        "placeholder:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 " +
        "focus-visible:outline-ring";

    /// <summary>
    /// Checks for a session before opening rather than after filling the form in. Being told to
    /// sign in is a reasonable answer; being told it after typing out what happened is not.
    /// </summary>
    private async Task OpenAsync()
    {
        if (await Api.GetCurrentUserAsync() is null)
        {
            Nav.NavigateTo($"/signin?returnTo={Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri) is var p && p.Length > 0 ? $"/{p}" : "/")}");
            return;
        }

        _open = true;
    }

    private async Task SubmitAsync()
    {
        _sending = true;
        _error = null;

        try
        {
            var result = await Api.FileReportAsync(SubjectKind, SubjectId, _category, _body);

            if (result.Success)
            {
                _sent = true;
                _open = false;
            }
            else
            {
                _error = result.Error ?? "The report was not accepted.";
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _error = "The API isn't responding. Nothing was sent.";
        }
        finally
        {
            _sending = false;
        }
    }
}
