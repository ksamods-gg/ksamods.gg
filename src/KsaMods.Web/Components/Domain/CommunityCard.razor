@namespace KsaMods.Web.Components.Domain
@using KsaMods.Web.Components.Ui
@inject DiscordPresenceCache Presence

@*
    The other half of what we run, on the page most people arrive at. This is a catalogue, and
    everything a catalogue is bad at (asking why a mod won't load, showing something half
    finished, finding somebody to test it) happens in the Discord instead.

    The disclaimer is a whole line rather than a parenthesis. "KSA Modding Society" and "Kitten
    Space Agency" are one word apart, and a reader skimming a link on a site about KSA will read
    it as the game's own server unless something says otherwise before they click.
*@

<section class="@Cx.Of("rounded-lg border border-border bg-card/40 p-5", Class)">
    <div class="flex items-start gap-3.5">
        <span class="mt-0.5 shrink-0 text-muted-foreground" aria-hidden="true">
            <ProviderMark Provider="discord" />
        </span>

        <div class="min-w-0">
            <h2 class="text-sm font-semibold">@Community.DiscordName</h2>

            @* Capped rather than left to fill the card. This block is full width where the two
               cards above it are half, so the same paragraph that reads at 65 characters up there
               ran to about 120 down here, which is where the eye starts losing the line coming
               back to the left edge. *@
            <p class="mt-1.5 max-w-lg text-sm leading-relaxed text-muted-foreground">
                We run a Discord for KSA modding, and this site grew out of it. There are channels
                for releases, for work in progress, and for the times something won't load and you
                want somebody to look at it with you.
            </p>

            <div class="mt-4 flex flex-wrap items-center gap-2">
                <Button Href="/discord" Size="sm">
                    <ProviderMark Provider="discord" Class="size-4" />
                    The Discord
                </Button>
                @if (_presence is not null)
                {
                    @* Only when we have the figure. A "members" label with nothing beside it is
                       worse than saying nothing at all. *@
                    <span class="text-xs text-muted-foreground">
                        <span class="tabular font-medium text-foreground">@_presence.Total.ToString("N0")</span> members,
                        <span class="tabular font-medium text-foreground">@_presence.Online.ToString("N0")</span> online
                    </span>
                }
            </div>

            <p class="mt-3.5 max-w-md text-xs leading-relaxed text-muted-foreground">
                Ours, not RocketWerkz's. It isn't the official Kitten Space Agency server.
            </p>
        </div>
    </div>
</section>

@code {
    [Parameter] public string? Class { get; set; }

    private DiscordPresence? _presence;

    protected override async Task OnInitializedAsync() => _presence = await Presence.CurrentAsync();
}
