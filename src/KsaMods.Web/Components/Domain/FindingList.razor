@namespace KsaMods.Web.Components.Domain
@using KsaMods.Web.Components.Ui
@using KsaMods.Web.Services

@*
    Findings a moderator has set aside are separated out rather than dropped. They are still the
    validator's answer about somebody's archive, and a site that says it shows what it found and
    then hides the inconvenient half is saying something untrue.

    Separating them does the job asked of it anyway: what is left above the line is what is
    actually outstanding, which is the question a reader has.
*@

@if (Findings.Count == 0)
{
    <p class="text-sm text-muted-foreground">
        Nothing to report. Every declared path resolved, and every declared XML parsed.
    </p>
}
else
{
    @if (Outstanding.Count == 0)
    {
        <p class="text-sm text-muted-foreground">
            Nothing outstanding. Everything the validator raised has been looked at.
        </p>
    }
    else
    {
        <ul class="divide-y divide-border">
            @foreach (var finding in Outstanding)
            {
                <li class="flex gap-3 py-3 first:pt-0 last:pb-0">
                    <Badge Variant="@Presentation.SeverityVariant(finding.Severity)" Class="mt-0.5 shrink-0 self-start">
                        @finding.Severity
                    </Badge>

                    <div class="min-w-0 flex-1">
                        <p class="text-sm">@finding.Message</p>

                        <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
                            @* The code is the contract - it is what a filter or a script keys on, so it
                               is shown rather than hidden behind the prose. *@
                            <code class="font-mono">@finding.Code</code>
                            <span>@Presentation.StageName(finding.Stage)</span>
                            @if (finding.Path is not null)
                            {
                                <code class="font-mono break-all">@finding.Path</code>
                            }
                        </p>
                    </div>
                </li>
            }
        </ul>
    }

    @if (SetAside.Count > 0)
    {
        @* Collapsed, and it stays collapsed: this is the group a reader can reasonably skip, and
           the reason a moderator gave is what they would open it for. *@
        <details class="@(Outstanding.Count > 0 ? "mt-5 border-t border-border pt-4" : "mt-4")">
            <summary class="cursor-pointer list-none text-xs text-muted-foreground
                            underline-offset-4 hover:text-foreground hover:underline
                            focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
                @SetAside.Count set aside by moderators
            </summary>

            <ul class="mt-3 space-y-3">
                @foreach (var finding in SetAside)
                {
                    <li class="flex gap-3">
                        <Badge Variant="outline" Class="mt-0.5 shrink-0 self-start">@finding.Severity</Badge>

                        <div class="min-w-0 flex-1">
                            <p class="text-sm text-muted-foreground">@finding.Message</p>

                            <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
                                <code class="font-mono">@finding.Code</code>
                                <span>@Presentation.StageName(finding.Stage)</span>
                            </p>

                            @if (!string.IsNullOrWhiteSpace(finding.SuppressedReason))
                            {
                                <p class="mt-1.5 border-l-2 border-border pl-2.5 text-xs italic leading-relaxed text-muted-foreground">
                                    @finding.SuppressedReason
                                </p>
                            }
                        </div>
                    </li>
                }
            </ul>
        </details>
    }
}

@code {
    [Parameter] public IReadOnlyList<FindingInfo> Findings { get; set; } = [];

    private IReadOnlyList<FindingInfo> Outstanding =>
        [.. Findings.Where(f => !f.Suppressed).OrderBy(SeverityRank).ThenBy(f => f.Stage)];

    private IReadOnlyList<FindingInfo> SetAside =>
        [.. Findings.Where(f => f.Suppressed).OrderBy(SeverityRank).ThenBy(f => f.Stage)];

    private static int SeverityRank(FindingInfo finding) => finding.Severity switch
    {
        "error" => 0,
        "warning" => 1,
        _ => 2,
    };
}
