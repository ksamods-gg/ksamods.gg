@namespace KsaMods.Web.Components.Domain
@using KsaMods.Web.Components.Ui
@using KsaMods.Web.Services

@*
    The row a visitor scans a hundred of.

    Icon left, name and id, one line of description, then the tags and the one honest piece of
    metadata this site has: when it was last updated. Deliberately not a download count - the site
    cannot measure installs, only outbound clicks, and a number that looks like installs but is not
    would be the first dishonest thing on the page.

    The banner stays, above the row, because authors already made them. It is the card's one moment
    of colour and it earns the space only when it exists.
*@

<a href="@($"/mods/{Mod.Id}")"
   @* Hover is a rule going firm, not an object lifting. The lift and the raised shadow belonged
      to the previous world, where a listing was a soft card you scanned a hundred of; here a
      listing is a region on a sheet, and a region does not leave the paper. *@
   class="group relative flex flex-col overflow-hidden border border-border bg-card
          transition-colors duration-150 hover:border-primary
          focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ring">

    @if (!string.IsNullOrWhiteSpace(Mod.BannerUrl))
    {
        @* Author-hosted and therefore unreliable: onerror drops the whole strip rather than
           leaving a broken-image icon wedged above the title. *@
        <div class="aspect-[16/5] w-full overflow-hidden border-b border-border bg-secondary">
            <img src="@Mod.BannerUrl" alt="" loading="lazy" referrerpolicy="no-referrer"
                 onerror="this.parentElement.remove()"
                 class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" />
        </div>
    }

    <div class="flex flex-1 gap-3.5 p-4">
        <ModIcon Id="@Mod.Id" IconUrl="@Mod.IconUrl" />

        <div class="flex min-w-0 flex-1 flex-col">
            <div class="flex items-start gap-2">
                <h3 class="min-w-0 flex-1 truncate text-[0.9375rem] font-semibold leading-tight
                           transition-colors group-hover:text-primary">
                    @Mod.Name
                </h3>

                @if (Mod.Type == "mod-loader")
                {
                    <Badge Variant="info" Class="shrink-0">loader</Badge>
                }
            </div>

            @* The id is the folder name the game loads it under, so it is shown verbatim and in
               mono: this is the string a user sees in their mods directory. *@
            <code class="mt-0.5 block truncate font-mono text-xs text-muted-foreground">@Mod.Id</code>

            <p class="mt-2 line-clamp-2 text-[0.8125rem] leading-relaxed text-muted-foreground">
                @Mod.Abstract
            </p>

            <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-3">
                @foreach (var tag in Mod.Tags.Take(3))
                {
                    <Badge Variant="outline" Class="rounded-sm px-2">@tag</Badge>
                }

                @if (Mod.Tags.Count > 3)
                {
                    <span class="font-mono text-[0.6875rem] text-muted-foreground">
                        +@(Mod.Tags.Count - 3)
                    </span>
                }

                <span class="ml-auto shrink-0 font-mono text-[0.6875rem] text-muted-foreground tabular">
                    @Presentation.Ago(Mod.UpdatedAt)
                </span>
            </div>
        </div>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public ModSummary Mod { get; set; } = default!;
}
