@namespace KsaMods.Web.Components.Domain
@using KsaMods.Web.Services

<a href="@($"/mods/{Mod.Id}")"
   class="group flex h-full flex-col rounded-lg border border-border bg-card p-4 transition-colors
          hover:border-ring focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">

    <div class="flex items-start justify-between gap-2">
        <h3 class="font-medium leading-tight group-hover:underline">@Mod.Name</h3>
        @if (Mod.Type == "mod-loader")
        {
            <Badge Variant="info" Class="shrink-0">Loader</Badge>
        }
    </div>

    @* The id is the KSA folder name, so it is worth showing verbatim: it is what the user will
       see in their mods directory and in manifest.toml. *@
    <code class="mt-0.5 font-mono text-xs text-muted-foreground">@Mod.Id</code>

    <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">@Mod.Abstract</p>

    <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-3">
        @foreach (var tag in Mod.Tags.Take(3))
        {
            <Badge Variant="outline">@tag</Badge>
        }
        <span class="ml-auto text-xs text-muted-foreground">@Presentation.Ago(Mod.UpdatedAt)</span>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public ModSummary Mod { get; set; } = default!;
}
