@namespace KsaMods.Web.Components.Layout
@using KsaMods.Web.Services
@inject SiteNoticeCache Notices

@if (Banner is { IsActive: true })
{
    <script type="module" src="@Assets["Components/Layout/SiteBanner.razor.js"]"></script>

    @* Starts hidden and is revealed by the script once it has checked whether this visitor
       already dismissed it. The other way round flashes the banner on every page load for
       people who closed it. *@
    <div id="site-banner" data-banner-key="@Banner.DismissKey" hidden
         role="@(IsUrgent ? "alert" : "status")"
         class="@StripClass">
        <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-2 text-sm">
            <span class="min-w-0">
                @Banner.Message
                @if (!string.IsNullOrWhiteSpace(Banner.LinkHref))
                {
                    <a href="@Banner.LinkHref" class="ml-1 font-medium underline underline-offset-4">
                        @(string.IsNullOrWhiteSpace(Banner.LinkText) ? "Read more" : Banner.LinkText)
                    </a>
                }
            </span>

            @if (Banner.Dismissible)
            {
                @* 32px square. It was a 26x18 hit box built out of padding around a glyph, which
                   is under the 24px minimum in both directions on the control most likely to be
                   pressed one-handed while walking. The mark is now drawn rather than typed: a
                   multiplication sign is not an icon, and Tabler at stroke-width 2 is what the
                   theme toggle beside it already uses. *@
                <button type="button" data-banner-dismiss aria-label="Dismiss this notice"
                        class="ml-auto inline-flex size-8 shrink-0 items-center justify-center rounded
                               opacity-70 transition-opacity hover:opacity-100
                               focus-visible:outline-2 focus-visible:outline-offset-2">
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 6 6 18" />
                        <path d="m6 6 12 12" />
                    </svg>
                </button>
            }
        </div>
    </div>
}

@code {
    private SiteNotice? Banner;

    /// <summary>
    /// Read on every render of the layout, which is every page. The cache is what makes that
    /// cheap; without it this would be an API call per page view for a thing that is empty
    /// almost always.
    /// </summary>
    protected override async Task OnInitializedAsync() => Banner = await Notices.CurrentAsync();

    private bool IsUrgent => Banner?.Variant is "warning" or "error";

    private string StripClass => Banner?.Variant switch
    {
        "error" => "border-b border-severity-error/30 bg-severity-error/10 text-severity-error",
        "warning" => "border-b border-severity-warning/30 bg-severity-warning/10 text-severity-warning",
        _ => "border-b border-border bg-accent text-accent-foreground",
    };
}
