@page "/bug"
@rendermode InteractiveServer
@inject KsaModsApi Api
@inject NavigationManager Nav

<PageTitle>Report a bug | ksamods.gg</PageTitle>

<div class="mx-auto max-w-2xl">
    <h1 class="text-2xl font-bold tracking-tight">Report a bug</h1>
    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
        Something on this site behaving wrongly: a page that won't load, a button that does
        nothing, a number that looks wrong. This goes to whoever maintains the site, and you'll be
        told here what came of it the next time you visit.
    </p>
    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
        A problem with somebody's mod, as opposed to with the site, is a different thing. Use the
        report link on that mod's page.
    </p>

    @if (_sent)
    {
        <Alert Variant="ok" Title="Sent" Class="mt-6">
            Thanks. You'll see what happened to it here next time you're signed in.
        </Alert>
        <div class="mt-6 flex gap-3">
            <Button Href="/" Size="sm">Go home</Button>
            <Button Variant="ghost" Size="sm" @onclick="Again">Report another</Button>
        </div>
    }
    else
    {
        @if (_error is not null)
        {
            <Alert Variant="error" Title="That didn't send" Class="mt-6">@_error</Alert>
        }

        <Card Class="mt-6">
            <div class="space-y-5">
                <Field Context="field" Id="summary" Label="What went wrong"
                       Hint="One sentence. This is what the queue shows.">
                    <input @attributes="field" @bind="_summary"
                           placeholder="Search returns nothing when I filter by a tag"
                           class="@InputClass" />
                </Field>

                <Field Context="field" Id="detail" Label="What you were doing" Required="false"
                       Hint="What you expected, what happened instead, and anything needed to see it again.">
                    <textarea @attributes="field" @bind="_detail" rows="6" class="@InputClass"></textarea>
                </Field>

                <Field Context="field" Id="page" Label="Which page" Required="false"
                       Hint="Filled in from where you came from. Change it if the problem was somewhere else.">
                    <input @attributes="field" @bind="_page" class="@Cx.Of(InputClass, "font-mono text-xs")" />
                </Field>
            </div>

            <Button Size="sm" Class="mt-6" Disabled="_sending || _summary.Trim().Length < 3"
                    Pending="_sending" PendingLabel="Sending…" @onclick="SubmitAsync">
                Send report
            </Button>
        </Card>
    }
</div>

@code {
    private string _summary = "";
    private string _detail = "";
    private string _page = "";
    private bool _sending;
    private bool _sent;
    private string? _error;

    private const string InputClass =
        "w-full rounded-md border border-input bg-background px-3 py-2 text-sm " +
        "placeholder:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 " +
        "focus-visible:outline-ring";

    /// <summary>
    /// Prefilled from wherever they were. Nobody remembers a URL, and "it was on some mod page"
    /// is an hour of guessing for whoever picks the report up.
    /// </summary>
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _page = string.IsNullOrWhiteSpace(From) ? "" : From;

        // Signed in, because the answer has to reach somebody. Checked before the form is drawn
        // rather than after it is filled in.
        if (await Api.GetCurrentUserAsync() is null)
        {
            Nav.NavigateTo($"/signin?returnTo={Uri.EscapeDataString($"/bug?from={Uri.EscapeDataString(_page)}")}");
        }
    }

    private void Again()
    {
        _sent = false;
        _summary = "";
        _detail = "";
    }

    private async Task SubmitAsync()
    {
        _sending = true;
        _error = null;

        try
        {
            var result = await Api.FileBugAsync(_summary.Trim(), _detail.Trim(), _page.Trim());

            if (result.NeedsSignIn)
            {
                Nav.NavigateTo($"/signin?returnTo={Uri.EscapeDataString("/bug")}");
                return;
            }

            if (result.Success) _sent = true;
            else _error = result.Error ?? "The report was not accepted.";
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _error = "The API isn't responding. Nothing was sent.";
        }
        finally
        {
            _sending = false;
        }
    }
}
