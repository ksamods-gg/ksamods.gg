@page "/account"
@rendermode InteractiveServer
@inject KsaModsApi Api
@inject AuthAvailability Auth
@inject NavigationManager Nav

<PageTitle>Your account | ksamods.gg</PageTitle>

@if (_loading)
{
    @* Both loaded branches below head the page differently - your display name when the profile
       arrives, "Your account" when it turns out you are signed out - so there is nothing truthful
       to show here yet. The heading is still present, just not drawn: what it costs is nothing on
       screen, and what it buys is that a route change is announced instead of landing somewhere
       with no heading to be sent to. *@
    <h1 class="sr-only">Your account</h1>
    <p class="text-sm text-muted-foreground">Loading…</p>
}
else if (_profile is null)
{
    @* Reachable by typing the URL, and the session may also have expired while the page sat
       open. Either way this is "sign in", not an error. *@
    <div class="mx-auto max-w-md py-8">
        <h1 class="text-2xl font-semibold tracking-tight">Your account</h1>
        <Alert Variant="info" Title="You are not signed in" Class="mt-6">
            Sign in to manage your profile, connected accounts and sessions.
        </Alert>
        <Button Href="/signin?returnTo=%2Faccount" Class="mt-6">Sign in</Button>
    </div>
}
else
{
    <div class="mx-auto max-w-2xl">
        <header class="flex items-center gap-4">
            @if (!string.IsNullOrWhiteSpace(_profile.AvatarUrl))
            {
                <img src="@_profile.AvatarUrl" alt="" width="48" height="48"
                     class="size-12 rounded-full border border-border object-cover"
                     referrerpolicy="no-referrer" />
            }
            <div class="min-w-0">
                <h1 class="text-2xl font-semibold tracking-tight">@_profile.DisplayName</h1>
                <p class="text-sm text-muted-foreground">
                    <span class="font-mono">@@@_profile.Handle</span>
                    · joined @_profile.CreatedAt.ToString("MMMM yyyy")
                    @if (_profile.IsModerator)
                    {
                        <span> · <Badge Variant="info">staff</Badge></span>
                    }
                </p>
            </div>
        </header>

        @if (_notice is not null)
        {
            <Alert Variant="ok" Class="mt-6">@_notice</Alert>
        }

        <!-- ── profile ─────────────────────────────────────────────── -->
        <Card Class="mt-8" Header="@(b => b.AddContent(0, "Profile"))">
            @if (_profileError is not null)
            {
                <Alert Variant="error" Class="mb-4">@_profileError</Alert>
            }

            <div class="space-y-5">
                <Field Context="field" Id="displayName" Label="Display name"
                       Hint="Shown on your listings. Any characters you like.">
                    <input @attributes="field" @bind="_form.DisplayName" class="@InputClass" />
                </Field>

                <Field Context="field" Id="handle" Label="Handle"
                       Hint="How other people refer to you. It's what a collaborator invite asks for. Letters, digits, '-' and '_'. Capitalisation is ignored when checking it is free.">
                    <input @attributes="field" @bind="_form.Handle" class="@Cx.Of(InputClass, "font-mono")"
                           autocomplete="off" spellcheck="false" />
                </Field>

                <Field Context="field" Id="bio" Label="About you" Required="false"
                       Hint="Shown on your public profile. A few sentences about what you make. 600 characters at most.">
                    <textarea @attributes="field" @bind="_form.Bio" rows="4" class="@InputClass"></textarea>
                </Field>

                <Field Context="field" Id="links" Label="Links" Required="false"
                       Hint="One per line, as name = https://… . These appear on your profile. Anything not https is refused.">
                    <textarea @attributes="field" @bind="_form.Links" rows="3"
                              placeholder="Discord = https://discord.gg/…&#10;YouTube = https://youtube.com/@@you"
                              class="@Cx.Of(InputClass, "font-mono text-xs")"></textarea>
                </Field>

                <Field Context="field" Id="forums" Label="KSA forums thread" Required="false"
                       Hint="Your thread on the KSA forums. Not needed to use the site, but a mod of yours needs one before it appears in the exported index other clients read.">
                    <input @attributes="field" type="url" @bind="_form.ForumsUrl"
                           placeholder="https://forums.ahwoo.com/members/…" class="@InputClass" />
                </Field>
            </div>

            <div class="mt-5 flex items-center gap-3">
                <Button Type="button" Disabled="_saving" Pending="_saving" PendingLabel="Saving…"
                        @onclick="SaveProfileAsync">
                    Save changes
                </Button>
                @if (_handleChanged)
                {
                    <span class="text-xs text-muted-foreground">
                        Changing your handle frees the old one for someone else to take.
                    </span>
                }
            </div>
        </Card>

        <!-- ── connected accounts ──────────────────────────────────── -->
        <Card Class="mt-6" Header="@(b => b.AddContent(0, "Connected accounts"))"
              Description="@(b => b.AddContent(0, "How you sign in"))">

            @if (_identityError is not null)
            {
                <Alert Variant="error" Class="mb-4">@_identityError</Alert>
            }

            <ul class="divide-y divide-border">
                @foreach (var identity in _profile.Identities)
                {
                    <li class="flex items-center gap-3 py-3 first:pt-0">
                        <ProviderMark Provider="@identity.Provider" Class="shrink-0" />
                        <div class="min-w-0">
                            <p class="text-sm font-medium">@DisplayName(identity.Provider)</p>
                            <p class="text-xs text-muted-foreground">
                                Connected @Presentation.Ago(identity.LinkedAt)
                            </p>
                        </div>

                        <div class="ml-auto">
                            @if (_profile.Identities.Count > 1)
                            {
                                <Button Type="button" Variant="ghost" Size="sm"
                                        @onclick="() => UnlinkAsync(identity.Provider)">
                                    Disconnect
                                </Button>
                            }
                            else
                            {
                                @* Disconnecting the only one leaves an account nobody can sign
                                   into - there is no password and no email to recover through. *@
                                <span class="text-xs text-muted-foreground">Only way in</span>
                            }
                        </div>
                    </li>
                }
            </ul>

            @{
                var unlinked = _available.Where(p => !_profile.Identities.Any(i => i.Provider == p)).ToList();
            }
            @if (unlinked.Count > 0)
            {
                <div class="mt-4 border-t border-border pt-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="text-sm text-muted-foreground">Also connect:</span>
                        @foreach (var provider in unlinked)
                        {
                            @* intent=link is what stops the callback creating a second account:
                               it attaches the identity to the session you already have. *@
                            <Button Href="@($"/auth/{provider}/start?intent=link&returnTo=%2Faccount")"
                                    Variant="outline" Size="sm">
                                @DisplayName(provider)
                            </Button>
                        }
                    </div>
                    <p class="mt-2 text-xs text-muted-foreground">
                        Connecting another provider gives you a second way into this same account.
                        It doesn't create a new one.
                    </p>
                </div>
            }
        </Card>

        <!-- ── your mods ──────────────────────────────────────────── -->
        @* Modlists are deliberately absent here. The API and the schema have them, the frontend
           does not, and this card used to link to /modlists/{id}, which is a 404. Listing
           something a person cannot open is worse than not mentioning it. *@
        @if (_profile.Mods.Count > 0)
        {
            <Card Class="mt-6" Header="@(b => b.AddContent(0, "Your mods"))"
                  Actions="@(b =>
                  {
                      b.OpenElement(0, "a");
                      b.AddAttribute(1, "href", "/my/mods");
                      b.AddAttribute(2, "class",
                          "text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline");
                      b.AddContent(3, "Manage your mods");
                      b.CloseElement();
                  })">

                @* This list says what you have; /my/mods says what needs you. *@
                <ul class="divide-y divide-border">
                    @foreach (var mod in _profile.Mods)
                    {
                        <li class="flex items-center gap-3 py-2 text-sm first:pt-0">
                            <a href="@($"/mods/{mod.Id}")" class="font-medium underline-offset-4 hover:underline">
                                @mod.Name
                            </a>
                            <code class="font-mono text-xs text-muted-foreground">@mod.Id</code>
                            <Badge Variant="outline" Class="ml-auto">@mod.Role</Badge>
                        </li>
                    }
                </ul>
            </Card>
        }

        <!-- ── sessions ────────────────────────────────────────────── -->
        <Card Class="mt-6" Header="@(b => b.AddContent(0, "Where you're signed in"))"
              Description="@(b => b.AddContent(0, $"{_sessions.Count} active"))">

            <ul class="divide-y divide-border">
                @foreach (var session in _sessions)
                {
                    <li class="flex items-center gap-3 py-3 text-sm first:pt-0">
                        <div class="min-w-0">
                            <p class="truncate">@Describe(session.UserAgent)</p>
                            <p class="text-xs text-muted-foreground">
                                Signed in @Presentation.Ago(session.IssuedAt)
                                · expires @session.ExpiresAt.ToString("d MMM yyyy")
                            </p>
                        </div>
                        @if (session.Current)
                        {
                            <Badge Variant="ok" Class="ml-auto">this device</Badge>
                        }
                    </li>
                }
            </ul>

            @if (_sessions.Count > 1)
            {
                <div class="mt-4 border-t border-border pt-4">
                    <Button Type="button" Variant="outline" Size="sm" @onclick="RevokeOthersAsync">
                        Sign out everywhere else
                    </Button>
                    <p class="mt-2 text-xs text-muted-foreground">
                        Ends every session except this one. Do this if you signed in somewhere you
                        no longer trust.
                    </p>
                </div>
            }
        </Card>

        <!-- ── API tokens ──────────────────────────────────────────── -->
        <Card Class="mt-6" Header="@(b => b.AddContent(0, "API tokens"))"
              Description="@(b => b.AddContent(0, "For reading, not writing"))">

            <p class="text-sm leading-relaxed text-muted-foreground">
                A token lets a script or a mod manager read the API as you, including your own
                drafts and failed validation reports, and raises the read limit from 300 requests
                a minute to 3000. It <span class="font-medium text-foreground">can't write</span>:
                publishing stays in the browser, and releases import themselves from your
                repository. So a token in a config file can't be spent on your listings.
            </p>

            @if (_minted is { Success: true })
            {
                @* Shown until dismissed, not in a toast. Nothing stores the secret, so a page that
                   loses this value has lost it permanently. *@
                <Alert Variant="ok" Title="Copy it now" Class="mt-5">
                    <p>This is the only time it's shown. We store a hash, so we can't show it again.</p>

                    <pre class="mt-3 overflow-x-auto rounded-md border border-border bg-background px-3 py-2 font-mono text-xs"><code>@_minted.Token</code></pre>

                    @if (_minted.Note is { Length: > 0 })
                    {
                        <p class="mt-2 text-xs">@_minted.Note</p>
                    }

                    <Button Type="button" Variant="outline" Size="sm" Class="mt-3"
                            @onclick="() => _minted = null">
                        Done
                    </Button>
                </Alert>
            }
            else if (_minted is { Error: { Length: > 0 } problem })
            {
                <Alert Variant="error" Class="mt-5">@problem</Alert>
            }

            @if (_tokens.Count > 0)
            {
                <ul class="mt-5 divide-y divide-border">
                    @foreach (var token in _tokens)
                    {
                        <li class="flex flex-wrap items-center gap-x-3 gap-y-1 py-3 first:pt-0">
                            <div class="min-w-0">
                                <p class="truncate text-sm font-medium">@token.Name</p>
                                <p class="mt-0.5 font-mono text-xs text-muted-foreground">
                                    @token.Prefix…
                                    · @(token.NeverUsed ? "never used" : $"used {Presentation.Ago(token.LastUsedAt!.Value)}")
                                    @if (token.ExpiresAt is { } expires)
                                    {
                                        <text> · expires @expires.ToString("d MMM yyyy")</text>
                                    }
                                </p>
                            </div>

                            @if (token.IsApplication)
                            {
                                <Badge Variant="outline">application</Badge>
                            }

                            <Button Type="button" Variant="ghost" Size="sm" Class="ml-auto"
                                    @onclick="() => RevokeTokenAsync(token)">
                                Revoke
                            </Button>
                        </li>
                    }
                </ul>
            }

            <div class="mt-5 flex flex-wrap items-end gap-2 border-t border-border pt-4">
                <div class="min-w-48 flex-1">
                    <label class="text-xs font-semibold uppercase tracking-wide text-muted-foreground"
                           for="tokenName">
                        Name it
                    </label>
                    <input id="tokenName" value="@_tokenName"
                           @oninput='e => _tokenName = e.Value?.ToString() ?? ""'
                           placeholder="release dashboard"
                           class="@Cx.Of(InputClass, "mt-1")" autocomplete="off" />
                </div>

                <div>
                    <label class="text-xs font-semibold uppercase tracking-wide text-muted-foreground"
                           for="tokenKind">
                        Kind
                    </label>
                    <select id="tokenKind" value="@_tokenKind"
                            @onchange='e => _tokenKind = e.Value?.ToString() ?? "personal"'
                            class="@Cx.Of(InputClass, "mt-1 w-auto")">
                        <option value="personal">Personal (reads as you)</option>
                        <option value="application">Application (identifies software)</option>
                    </select>
                </div>

                <Button Type="button" Disabled="_minting" Pending="_minting" @onclick="CreateTokenAsync">
                    Create
                </Button>
            </div>

            <p class="mt-2 text-xs text-muted-foreground">
                A personal token sees your drafts. An application token identifies a piece of
                software and sees only what anybody can. Use it for a public mod manager, where
                the key ends up on somebody else's machine.
            </p>
        </Card>

        <!-- ── danger zone ─────────────────────────────────────────── -->
        <Card Class="mt-6 border-severity-error/30" Header="@(b => b.AddContent(0, "Delete account"))">
            @if (!_confirmingDelete)
            {
                <p class="text-sm text-muted-foreground">
                    Your mods stay published. People have them installed, and other listings
                    point at them. What goes is the account: your name, your avatar, your sign-in
                    links, and every session. It can't be undone, and you can't sign back in.
                </p>
                <Button Type="button" Variant="outline" Size="sm" Class="mt-4"
                        @onclick="() => _confirmingDelete = true">
                    Delete my account
                </Button>
            }
            else
            {
                <Alert Variant="error" Title="This can't be undone">
                    Type your handle <code class="font-mono">@_profile.Handle</code> to confirm.
                </Alert>

                <input @bind="_deleteConfirmation" @bind:event="oninput"
                       class="@Cx.Of(InputClass, "mt-4 font-mono")" autocomplete="off" />

                <div class="mt-4 flex items-center gap-3">
                    <Button Type="button" Variant="destructive" Disabled="!DeleteConfirmed || _deleting"
                            Pending="_deleting" PendingLabel="Deleting…" @onclick="DeleteAsync">
                        Delete permanently
                    </Button>
                    <Button Type="button" Variant="ghost" @onclick="CancelDelete">Cancel</Button>
                </div>
            }
        </Card>
    </div>
}

@code {
    private const string InputClass =
        "w-full rounded-md border border-input bg-background px-3 py-2 text-sm " +
        "placeholder:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 " +
        "focus-visible:outline-ring";

    private AccountProfile? _profile;
    private IReadOnlyList<AccountSession> _sessions = [];
    private IReadOnlyList<string> _available = [];

    private readonly Form _form = new();
    private string _originalHandle = "";

    private bool _loading = true;
    private bool _saving;
    private bool _deleting;
    private bool _confirmingDelete;
    private string _deleteConfirmation = "";

    private string? _notice;
    private string? _profileError;
    private string? _identityError;

    private IReadOnlyList<ApiToken> _tokens = [];
    private MintedToken? _minted;
    private string _tokenName = "";
    private string _tokenKind = "personal";
    private bool _minting;

    private bool _handleChanged =>
        !string.Equals(_form.Handle?.Trim(), _originalHandle, StringComparison.Ordinal);

    // Case-insensitive, because the handle itself is: asking someone to match capitalisation they
    // cannot see would be a puzzle, not a safeguard.
    private bool DeleteConfirmed =>
        string.Equals(_deleteConfirmation.Trim(), _profile?.Handle, StringComparison.OrdinalIgnoreCase);

    [SupplyParameterFromQuery] public string? Linked { get; set; }
    [SupplyParameterFromQuery(Name = "link_error")] public string? LinkError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // The provider redirect lands back here with the outcome, because the round trip leaves
        // the page and cannot carry component state across it.
        if (Linked is { Length: > 0 })
        {
            _notice = $"{DisplayName(Linked)} connected. You can now sign in with either.";
        }
        else if (LinkError is { Length: > 0 })
        {
            _identityError = LinkError switch
            {
                "taken" => "That account is already connected to a different ksamods.gg account. "
                         + "An account can only be connected in one place, so disconnect it there first.",
                "session_expired" => "You were signed out while connecting. Sign in and try again.",
                _ => "Could not connect that account.",
            };
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            _profile = await Api.GetProfileAsync();

            if (_profile is not null)
            {
                _sessions = await Api.GetSessionsAsync() ?? [];
                _tokens = await Api.GetTokensAsync() ?? [];
                _available = await Auth.ProvidersAsync();

                _form.DisplayName = _profile.DisplayName;
                _form.Handle = _profile.Handle;
                _form.ForumsUrl = _profile.ForumsUrl ?? "";
                _form.Bio = _profile.Bio ?? "";
                _form.Links = string.Join("\n", _profile.Links.Select(l => $"{l.Key} = {l.Value}"));
                _originalHandle = _profile.Handle;
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _profile = null;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Turns the "name = url" textarea into the map the API takes.
    ///
    /// <para>A textarea rather than a repeating row of paired inputs because people have one or
    /// two links, not ten, and a widget with add and remove buttons is more to operate than the
    /// thing it is collecting. Lines without an '=' are dropped rather than reported: the hint
    /// above the box says the shape, and a half-typed line is not an error yet.</para>
    /// </summary>
    private static Dictionary<string, string> ParseLinks(string? text)
    {
        var links = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        foreach (var line in (text ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries))
        {
            var split = line.IndexOf('=');
            if (split <= 0) continue;

            var name = line[..split].Trim();
            var url = line[(split + 1)..].Trim();

            if (name.Length > 0 && url.Length > 0) links[name] = url;
        }

        return links;
    }

    private async Task SaveProfileAsync()
    {
        _saving = true;
        _profileError = null;
        _notice = null;

        try
        {
            var result = await Api.UpdateProfileAsync(new UpdateProfileRequest(
                _form.DisplayName?.Trim(),
                _form.Handle?.Trim(),
                // Empty string means "clear it"; null means "leave it alone". The API tells them
                // apart, so the form must too.
                _form.ForumsUrl?.Trim() ?? "",
                _form.Bio?.Trim() ?? "",
                ParseLinks(_form.Links)));

            if (result.Success)
            {
                _notice = "Profile saved.";
                await LoadAsync();
            }
            else if (result.NeedsSignIn)
            {
                Nav.NavigateTo("/signin?returnTo=%2Faccount", forceLoad: true);
            }
            else
            {
                _profileError = result.Error ?? "Could not save your profile.";
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task UnlinkAsync(string provider)
    {
        _identityError = null;
        _notice = null;

        var result = await Api.UnlinkIdentityAsync(provider);

        if (result.Success)
        {
            _notice = $"{DisplayName(provider)} disconnected.";
            await LoadAsync();
        }
        else
        {
            _identityError = result.Error ?? "Could not disconnect that account.";
        }
    }

    private async Task CreateTokenAsync()
    {
        if (string.IsNullOrWhiteSpace(_tokenName))
        {
            _minted = new MintedToken { Error = "Give it a name you will recognise in six months." };
            return;
        }

        _minting = true;

        try
        {
            _minted = await Api.CreateTokenAsync(_tokenName.Trim(), _tokenKind, expiresInDays: null);

            if (_minted is { Success: true })
            {
                _tokenName = "";
                _tokens = await Api.GetTokensAsync() ?? [];
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _minted = new MintedToken { Error = "The API isn't responding." };
        }
        finally
        {
            _minting = false;
        }
    }

    private async Task RevokeTokenAsync(ApiToken token)
    {
        // No confirmation step. Revoking is the safe direction - the cost of doing it by accident
        // is making a new one, and a dialog between somebody and revoking a leaked credential is
        // a dialog on the wrong side.
        if (await Api.RevokeTokenAsync(token.Id))
        {
            _notice = $"'{token.Name}' revoked. Anything using it stops working now.";
            _tokens = await Api.GetTokensAsync() ?? [];
        }
    }

    private async Task RevokeOthersAsync()
    {
        var revoked = await Api.RevokeOtherSessionsAsync();

        _notice = revoked switch
        {
            0 => "There were no other sessions to end.",
            1 => "One other session ended.",
            _ => $"{revoked} other sessions ended.",
        };

        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (!DeleteConfirmed) return;

        _deleting = true;

        try
        {
            var result = await Api.DeleteAccountAsync();

            // forceLoad, because the session is gone: a soft navigation would keep rendering from
            // a circuit whose account no longer exists.
            if (result.Success) Nav.NavigateTo("/", forceLoad: true);
            else _profileError = result.Error ?? "Could not delete the account.";
        }
        finally
        {
            _deleting = false;
        }
    }

    private void CancelDelete()
    {
        _confirmingDelete = false;
        _deleteConfirmation = "";
    }

    private static string DisplayName(string provider) => provider switch
    {
        "github" => "GitHub",
        "discord" => "Discord",
        _ => provider,
    };

    /// <summary>
    /// A readable device name from the user agent. The point of the session list is "is anything
    /// here not me", and a raw UA string answers that worse than three words do.
    /// </summary>
    private static string Describe(string? userAgent)
    {
        if (string.IsNullOrWhiteSpace(userAgent)) return "Unknown device";

        var browser =
            userAgent.Contains("Edg/", StringComparison.Ordinal) ? "Edge"
            : userAgent.Contains("Firefox/", StringComparison.Ordinal) ? "Firefox"
            : userAgent.Contains("Chrome/", StringComparison.Ordinal) ? "Chrome"
            : userAgent.Contains("Safari/", StringComparison.Ordinal) ? "Safari"
            : "Browser";

        var platform =
            userAgent.Contains("Windows", StringComparison.Ordinal) ? "Windows"
            : userAgent.Contains("Android", StringComparison.Ordinal) ? "Android"
            : userAgent.Contains("iPhone", StringComparison.Ordinal) ? "iPhone"
            : userAgent.Contains("Mac OS X", StringComparison.Ordinal) ? "macOS"
            : userAgent.Contains("Linux", StringComparison.Ordinal) ? "Linux"
            : "unknown platform";

        return $"{browser} on {platform}";
    }

    private sealed class Form
    {
        public string? DisplayName { get; set; }
        public string? Handle { get; set; }
        public string? ForumsUrl { get; set; }
        public string? Bio { get; set; }
        public string? Links { get; set; }
    }
}
