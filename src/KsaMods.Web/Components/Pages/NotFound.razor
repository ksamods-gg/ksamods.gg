@page "/not-found"
@layout MainLayout

<PageTitle>Not found | ksamods.gg</PageTitle>

<div class="mx-auto max-w-md py-16 text-center">
    <p class="font-mono text-sm text-primary">404</p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight">This page is not here</h1>
    <p class="mt-3 text-sm text-muted-foreground">
        The link may be old, or the listing behind it may have been withdrawn.
    </p>

    <div class="mt-6 flex justify-center gap-3">
        <Button Href="/mods" Size="sm">Browse mods</Button>
        <Button Href="/" Variant="ghost" Size="sm">Go home</Button>
    </div>
</div>
