@page "/api-reference"

@* Route is /api-reference, not /api: ApiProxy claims /api/{**path} and forwards it to the
   backend, so a page mounted there would be unreachable. *@

<PageTitle>API reference | ksamods.gg</PageTitle>

@*
    The endpoint tables render from the arrays in @code rather than being written out as markup.
    There are eighty-odd routes; as markup that is a thousand lines of <tr> in which a stale path
    is invisible and adding one means copying a row and hoping. As data each is one line, and the
    rendering is written once.
*@

<div class="mx-auto max-w-6xl lg:grid lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-12">

    @* Sticky on desktop, a plain block on a phone. A table of contents that scrolls away is the
       one thing a reference page cannot afford: it is the way back from "what was that route
       called" to the route. *@
    <nav class="mb-10 lg:sticky lg:top-8 lg:mb-0 lg:max-h-[calc(100vh-4rem)] lg:overflow-y-auto lg:pb-8"
         aria-label="On this page">
        <p class="field-label text-muted-foreground">On this page</p>
        <ul class="mt-3 space-y-0.5 border-l border-border">
            @foreach (var (id, label) in Contents)
            {
                <li>
                    <a href="@($"/api-reference#{id}")" class="-ml-px block border-l border-transparent py-1 pl-3 text-[0.8125rem] text-muted-foreground
                        transition-colors hover:border-primary hover:text-foreground">
                        @label
                    </a>
                </li>
            }
        </ul>
    </nav>

    <div class="min-w-0">
        <header>
            <h1 class="mt-3 text-3xl font-bold tracking-tight">The ksamods.gg API</h1>
            <p class="mt-4 max-w-2xl leading-relaxed text-muted-foreground">
                Everything you can see on this site, you can read as JSON. Reads need no key and no
                account, because the whole point of an index is that other people's tools can use it.
            </p>
        </header>

        <section id="basics" class="mt-12 scroll-mt-8">
            <h2 class="text-lg font-semibold tracking-tight">Basics</h2>
            <dl class="mt-4 divide-y divide-border overflow-hidden rounded-lg border border-border">
                @foreach (var (term, description) in Basics)
                {
                    <div class="gap-4 px-4 py-3 sm:flex">
                        <dt class="w-32 shrink-0 text-sm text-muted-foreground">@term</dt>
                        <dd class="mt-1 text-sm sm:mt-0">@description</dd>
                    </div>
                }
            </dl>
        </section>

        <section id="auth" class="mt-12 scroll-mt-8">
            <h2 class="text-lg font-semibold tracking-tight">Authentication</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                Reads are anonymous. For anything else there are two credentials, and which one you
                want depends on whether a person is present.
            </p>

            <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <Card Header="@(b => b.AddContent(0, "Session cookie"))">
                    <p class="text-sm leading-relaxed text-muted-foreground">
                        What signing in gives you. HttpOnly, so a script cannot read it. This one is
                        for the site itself, not for anything you are writing.
                    </p>
                </Card>

                <Card Header="@(b => b.AddContent(0, "API token"))">
                    <p class="text-sm leading-relaxed text-muted-foreground">
                        A bearer token tied to your account, for a script, a CI job or a mod manager.
                        Revocable on its own, without signing anything else out.
                    </p>
                </Card>
            </div>

            <pre class="mt-4 overflow-x-auto rounded-lg border border-border bg-muted/50 p-4 text-xs leading-relaxed"
                 tabindex="0" role="region" aria-label="Example authenticated request, scrollable"><code>curl https://ksamods.gg/api/v1/me/profile \
  -H "Authorization: Bearer ksm_pat_..."</code></pre>

            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                The header, and only the header. Never a query string: URLs reach proxy logs, browser
                history and referrer headers, and a credential that leaks by being copied out of an
                address bar is one nobody knows to revoke.
            </p>

            <h3 class="mt-6 text-sm font-semibold">Two kinds, and the prefix says which</h3>

            <div class="mt-3 overflow-x-auto" tabindex="0" role="region" aria-label="Token kinds, scrollable">
                <table class="w-full min-w-[30rem] border-collapse text-left text-sm">
                    <thead>
                        <tr class="border-b border-border text-xs uppercase tracking-wider text-muted-foreground">
                            <th class="py-2 pr-4 font-medium">Prefix</th>
                            <th class="py-2 pr-4 font-medium">Kind</th>
                            <th class="py-2 font-medium">Can do</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        <tr>
                            <td class="py-2.5 pr-4 align-top font-mono text-xs">ksm_pat_</td>
                            <td class="py-2.5 pr-4 align-top">Personal</td>
                            <td class="py-2.5 align-top text-muted-foreground">
                                Everything you can do signed in, writes included.
                            </td>
                        </tr>
                        <tr>
                            <td class="py-2.5 pr-4 align-top font-mono text-xs">ksm_app_</td>
                            <td class="py-2.5 pr-4 align-top">Application</td>
                            <td class="py-2.5 align-top text-muted-foreground">
                                Reads only — not by policy. An application token cannot satisfy a
                                write check at all, so a leaked one cannot change anything.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <Alert Variant="info" Title="The secret is shown once" Class="mt-5">
                We keep a SHA-256 hash, so we cannot show it again and cannot recover it. A lost
                token is revoked and replaced, not looked up.
            </Alert>
        </section>

        <section id="limits" class="mt-12 scroll-mt-8">
            <h2 class="text-lg font-semibold tracking-tight">Rate limits and errors</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                300 reads and 60 writes a minute. Counted per token where you send one, otherwise per
                account, otherwise per address — so a token means a shared office network does not
                spend your budget, and you do not spend theirs.
            </p>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                Errors are RFC 9457 problem details. Read
                <code class="font-mono text-xs">detail</code> for something worth showing a person;
                the status code is for your control flow.
            </p>
        </section>

        @foreach (var group in Groups)
        {
            <section id="@group.Id" class="mt-12 scroll-mt-8">
                <h2 class="text-lg font-semibold tracking-tight">@group.Title</h2>
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted-foreground">@group.Blurb</p>

                @* The min-width forces this to overflow on a phone, which is what makes the
                   keyboard affordance below load-bearing rather than decorative. *@
                <div class="mt-4 overflow-x-auto" tabindex="0" role="region"
                     aria-label="@(group.Title + " endpoints, scrollable")">
                    <table class="w-full min-w-[36rem] border-collapse text-left">
                        <thead class="sr-only">
                            <tr>
                                <th>Method</th>
                                <th>Path</th>
                                <th>What it does</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border">
                            @foreach (var endpoint in group.Endpoints)
                            {
                                <tr>
                                    <td class="py-3 pr-3 align-top">
                                        <span class="@MethodClass(endpoint.Method)">@endpoint.Method</span>
                                    </td>
                                    <td class="py-3 pr-4 align-top font-mono text-xs">
                                        @endpoint.Path
                                        @if (endpoint.Auth)
                                        {
                                            <span
                                            class="ml-1.5 align-middle text-[0.625rem] uppercase tracking-wider text-muted-foreground"
                                            title="Needs a session or a personal token">auth</span>
                                        }
                                    </td>
                                    <td class="py-3 align-top text-sm text-muted-foreground">@endpoint.Summary</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        <section id="search" class="mt-12 scroll-mt-8">
            <h2 class="text-lg font-semibold tracking-tight">Search and paging</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                All optional, all on <code class="font-mono text-xs">/mods</code> and
                <code class="font-mono text-xs">/content</code>.
            </p>
            <ul class="mt-3 space-y-1.5 text-sm text-muted-foreground">
                <li><code class="font-mono text-xs text-foreground">q</code> — matches name and short description.</li>
                <li><code class="font-mono text-xs text-foreground">tag</code> — filters to one tag.</li>
                <li><code class="font-mono text-xs text-foreground">type</code> — <code
                    class="font-mono text-xs">mod</code> or <code class="font-mono text-xs">mod-loader</code>.</li>
                    <li><code class="font-mono text-xs text-foreground">gameBuild</code> — keeps only what has a release for
                        that revision.</li>
                        <li><code class="font-mono text-xs text-foreground">limit</code> — defaults to 50, capped at 200.</li>
                        <li><code class="font-mono text-xs text-foreground">after</code> — the cursor.</li>
                    </ul>

                    <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
                        Responses carry a <code class="font-mono text-xs">next</code> value. Pass it back as
                        <code class="font-mono text-xs">after</code> for the following page, and stop when it
                        comes back null. It is a cursor rather than an offset on purpose: offsets skip and
                        repeat rows when the catalogue changes mid-scroll, so anything taking a full snapshot
                        would end up with a corrupt one.
                    </p>
                </section>

                <section id="resolve" class="mt-12 scroll-mt-8">
                    <h2 class="text-lg font-semibold tracking-tight">Resolving an install</h2>
                    <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                        <code class="font-mono text-xs">POST /resolve</code> takes what you want and returns a
                        concrete install plan, or an explanation of why there is not one. It also reports
                        asset id collisions between the mods you picked, which is the failure a player
                        otherwise discovers by noticing something silently missing in game.
                    </p>

                    <pre class="mt-4 overflow-x-auto rounded-lg border border-border bg-muted/50 p-4 text-xs leading-relaxed"
                         tabindex="0" role="region" aria-label="Example resolve request, scrollable"><code>POST /api/v1/resolve
Content-Type: application/json

{
  "content": [
    { "id": "OuterPlanets", "version": "1.2.0" },
    { "id": "AdvancedFlightComputer" }
  ],
  "gameBuild": 5117,
  "includeRecommended": false
}</code></pre>

                    <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                        Leave <code class="font-mono text-xs">version</code> out to take the newest release
                        that fits. <code class="font-mono text-xs">gameBuild</code> is the revision from
                        <code class="font-mono text-xs">/builds</code> — the fourth component of the game's
                        version, and the only one that orders.
                    </p>
                </section>

                <section id="caveats" class="mt-12 scroll-mt-8">
                    <h2 class="text-lg font-semibold tracking-tight">Before you build on this</h2>

                    <Alert Variant="warning" Title="Download URLs are not ours" Class="mt-4">
                        Every release points at a file on the author's own forge, and we store the
                        <code class="font-mono text-xs">sha256</code> we measured when we checked it. Verify
                        that hash after downloading. If it does not match, do not install the file: the bytes
                        changed after we looked at them.
                    </Alert>

                    <Alert Variant="warning" Title="Passing validation is not a safety verdict" Class="mt-3">
                        Findings tell you an archive is packaged the way the game expects. Code mods are
                        unsandboxed assemblies, and no amount of packaging analysis tells you what one does
                        once it is running.
                    </Alert>
                </section>

                <section id="export" class="mt-12 scroll-mt-8">
                    <h2 class="text-lg font-semibold tracking-tight">The exported index</h2>
                    <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                        If you want the whole catalogue rather than a query against it, there is a static
                        export and a git mirror of it, both built to keep working if this API is not. Polling
                        <code class="font-mono text-xs">/mods</code> in a loop is the wrong tool for that job.
                    </p>
                    <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                        It is one snapshot document carrying every listing joined to its releases, the index
                        status and the game build list. There is no timestamp field in it, so an unchanged
                        index keeps its ETag and costs a poller one 304.
                    </p>
                </section>
            </div>
        </div>

@code {
    private sealed record Endpoint(string Method, string Path, string Summary, bool Auth = false);

    private sealed record Group(string Id, string Title, string Blurb, Endpoint[] Endpoints);

    private static readonly (string Id, string Label)[] Contents =
    [
        ("basics", "Basics"),
        ("auth", "Authentication"),
        ("limits", "Rate limits and errors"),
        ("catalogue", "Catalogue"),
        ("listings", "Managing a listing"),
        ("releases", "Releases"),
        ("modlists", "Modlists"),
        ("account", "Your account"),
        ("tokens", "API tokens"),
        ("community", "Tags and reports"),
        ("search", "Search and paging"),
        ("resolve", "Resolving an install"),
        ("caveats", "Before you build on this"),
        ("export", "The exported index"),
    ];

    private static readonly (string Term, string Description)[] Basics =
    [
        ("Base URL", "/api/v1"),
        ("Format", "JSON, UTF-8."),
        ("Auth", "None for reads. A session cookie or a bearer token for everything else."),
        ("Rate limit", "300 reads and 60 writes a minute."),
        ("Errors", "RFC 9457 problem details."),
    ];

    /// <summary>
    /// The routes a consumer outside the site can call.
    ///
    /// <para>The staff-only surface under <c>/api/v1/admin</c> is deliberately absent: it is
    /// another twenty-odd routes that answer 403 to everyone reading this page, and a reference is
    /// more useful for leaving them out than for being exhaustive about them.</para>
    /// </summary>
    private static readonly Group[] Groups =
    [
        new("catalogue", "Catalogue",
            "No account needed. These are the endpoints a launcher or a mod manager spends its time in.",
            [
                new("GET", "/mods", "Search and list mods."),
                new("GET", "/content", "The same search across mods and modlists together."),
                new("GET", "/mods/{id}", "One listing with its releases."),
                new("GET", "/mods/{id}/releases/{version}", "One release: download URL, hash, dependencies, findings."),
                new("GET", "/collisions/{assetId}", "Everyone declaring that asset id. More than one means they conflict."),
                new("GET", "/builds", "Known game builds and their revisions."),
                new("GET", "/tags", "The curated tag vocabulary."),
                new("GET", "/accounts/{handle}", "A public profile and what it maintains."),
                new("POST", "/resolve", "Turn a wanted set into an install plan."),
            ]),

        new("listings", "Managing a listing",
            "Every route here checks your role on that specific mod, not merely that you are signed in.",
            [
                new("POST", "/mods", "Create a listing.", true),
                new("PATCH", "/mods/{id}", "Edit name, description, tags, links, compatibility, install descriptor.", true),
                new("POST", "/mods/{id}/publish", "Put it in browse and search.", true),
                new("POST", "/mods/{id}/unlist", "Take it back out. It stays resolvable by id.", true),
                new("DELETE", "/mods/{id}", "Delete it, if nothing references it.", true),
                new("GET", "/mods/{id}/maintainers", "Who can work on it.", true),
                new("POST", "/mods/{id}/maintainers", "Add a maintainer.", true),
                new("DELETE", "/mods/{id}/maintainers/{handle}", "Remove one.", true),
                new("POST", "/mods/{id}/owner", "Transfer ownership.", true),
                new("GET", "/mods/{id}/repo-link", "The connected repository, and the proof while it is unverified.", true),
                new("POST", "/mods/{id}/repo-link", "Connect the repository releases come from.", true),
                new("POST", "/mods/{id}/repo-link/verify", "Check the ownership proof.", true),
            ]),

        new("releases", "Releases",
            "Releases are imported from the repository you already publish from. Nothing here uploads a file.",
            [
                new("POST", "/mods/{id}/releases/import", "Pull in tagged releases. Returns a job id.", true),
                new("GET", "/jobs/{jobId}", "How that import is going.", true),
                new("PATCH", "/mods/{id}/releases/{version}", "Amend a published release. Compatibility can only narrow.", true),
                new("POST", "/mods/{id}/releases/{version}/yank", "Retract one build. It stays in history.", true),
            ]),

        new("modlists", "Modlists",
            "A curated, pinned set. A published version is immutable, so a list somebody installed keeps working.",
            [
                new("GET", "/modlists/{id}", "A modlist and its published versions."),
                new("GET", "/modlists/{id}/versions/{version}", "One published version, with its pins."),
                new("GET", "/modlists/{id}/activity", "What changed, and who changed it.", true),
                new("POST", "/modlists", "Create one.", true),
                new("POST", "/modlists/{id}/draft/entries", "Add a pin to the draft.", true),
                new("DELETE", "/modlists/{id}/draft/entries/{kind}/{targetId}", "Remove one.", true),
                new("POST", "/modlists/{id}/publish", "Freeze the draft as a version.", true),
                new("POST", "/modlists/{id}/collaborators", "Invite someone to help.", true),
            ]),

        new("account", "Your account",
            "Everything under /me is about the caller. No route here reads somebody else's private data.",
            [
                new("GET", "/me", "Who you are, as the site sees you.", true),
                new("GET", "/me/profile", "Your profile, including what is not public.", true),
                new("PATCH", "/me/profile", "Change display name, bio, links.", true),
                new("GET", "/me/mods", "Listings you own or maintain, and what needs you.", true),
                new("GET", "/me/sessions", "Where you are signed in.", true),
                new("POST", "/me/sessions/revoke-others", "Sign out everywhere else.", true),
                new("DELETE", "/me/identities/{provider}", "Unlink a sign-in provider.", true),
                new("POST", "/me/delete", "Delete your account.", true),
                new("GET", "/auth/providers", "Which sign-in providers are configured."),
            ]),

        new("tokens", "API tokens",
            "Created and revoked with a session, never with a token — so a stolen token cannot mint its own replacement or outlive the moment you notice it.",
            [
                new("GET", "/me/tokens", "Your tokens: name, prefix, last used. Never the secret.", true),
                new("POST", "/me/tokens", "Create one. The only time the secret is shown.", true),
                new("DELETE", "/me/tokens/{id}", "Revoke it, immediately.", true),
            ]),

        new("community", "Tags and reports",
            "Tags come from a curated list, which is what makes browsing by one worth doing. Anyone can propose an addition.",
            [
                new("POST", "/tags", "Propose a tag for review.", true),
                new("POST", "/reports", "Report a listing or a release.", true),
                new("POST", "/bugs", "Report a problem with the site.", true),
                new("GET", "/notice", "The site-wide notice, if there is one."),
            ]),
    ];

    private static string MethodClass(string method) => Cx.Of(
        "inline-block w-[3.75rem] rounded px-1.5 py-0.5 text-center font-mono text-[0.6875rem] font-semibold",
        method switch
        {
            "GET" => "bg-severity-info/10 text-severity-info",
            "POST" => "bg-severity-ok/10 text-severity-ok",
            "PATCH" => "bg-severity-warning/10 text-severity-warning",
            "DELETE" => "bg-severity-error/10 text-severity-error",
            _ => "bg-muted text-muted-foreground",
        });
}
