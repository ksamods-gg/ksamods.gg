@page "/mods/new"
@rendermode InteractiveServer
@using System.Net
@using KsaMods.Metadata
@inject KsaModsApi Api
@inject NavigationManager Nav

<PageTitle>Add a mod | ksamods.gg</PageTitle>

@*
    Signed-out visitors never see this form. Creating a listing needs a session, so letting
    someone fill in six fields and then telling them to sign in wastes their work and reads like
    a bug. They go to the sign-in page and come straight back here afterwards.
*@
<div class="mx-auto max-w-2xl">
    <h1 class="text-2xl font-semibold tracking-tight">Add a mod</h1>
    <p class="mt-2 text-muted-foreground">
        This creates the listing. Releases arrive later, by connecting the repository you tag them in.
    </p>

    @*
        The heading is outside the gate below, so it is on the page from the first frame rather
        than arriving with the form. This component prerenders and then initialises a second time
        when the interactive circuit attaches, and with the heading inside the gate that second
        pass took it back off the page - a visible flicker, and a moment where the route has
        changed and there is no heading for a screen reader to be sent to.
    *@
    @if (!_ready)
    {
        <p class="mt-6 font-mono text-xs text-muted-foreground">Loading…</p>
    }
    else
    {
        @if (_serverError is not null)
        {
            <Alert Variant="error" Title="Could not create the listing" Class="mt-6">@_serverError</Alert>
        }

        <EditForm Model="_form" OnValidSubmit="SubmitAsync" FormName="new-mod" class="mt-6 space-y-5">
            <DataAnnotationsValidator />

            <Card>
                <Field Context="field" Id="id" Label="Mod id" Error="@_idError"
                       Hint="The folder name the game will see, exactly. This is the mod's identity, and you can't change it later.">
                    <input @attributes="field" @bind="_form.Id" @bind:event="oninput" @bind:after="ValidateId"
                           autocomplete="off" spellcheck="false" class="@IdInputClass" />
                </Field>

                @if (_idPreview is not null)
                {
                    <p class="mt-2 font-mono text-xs text-muted-foreground">
                        Installs to <span class="text-foreground">…/mods/@_idPreview/</span>
                    </p>
                }

                <div class="mt-5 space-y-5">
                    <Field Context="field" Id="name" Label="Display name" Hint="Whatever you want to call it. You can change this later.">
                        <input @attributes="field" @bind="_form.Name" class="@InputClass" />
                    </Field>

                    <Field Context="field" Id="abstract" Label="Short description"
                           Hint="One or two sentences, shown in search results.">
                        <textarea @attributes="field" @bind="_form.Abstract" rows="2" class="@InputClass"></textarea>
                    </Field>

                    <Field Context="field" Id="license" Label="License"
                           Hint="An SPDX identifier such as MIT, Apache-2.0 or CC-BY-4.0.">
                        <input @attributes="field" @bind="_form.License" list="spdx" class="@InputClass" />
                        <datalist id="spdx">
                            <option value="MIT" />
                            <option value="Apache-2.0" />
                            <option value="GPL-3.0-or-later" />
                            <option value="CC-BY-4.0" />
                            <option value="CC0-1.0" />
                        </datalist>
                    </Field>

                    <Field Context="field" Id="banner" Label="Banner image" Required="false"
                           Hint="An https link to a wide image, roughly 3:1. It shows at the top of your mod page and on your card when people browse. We only store the link, so leave the file where it is.">
                        <input @attributes="field" type="url" @bind="_form.BannerUrl"
                               placeholder="https://…/banner.png" class="@InputClass" />
                    </Field>

                    <Field Context="field" Id="forums" Label="KSA forums thread" Required="false"
                           Hint="You don't need this to create the listing: connecting your repository is what proves it's yours. You do need it before the listing shows up in the exported index other clients read.">
                        <input @attributes="field" type="url" @bind="_form.Forums"
                               placeholder="https://forums.ahwoo.com/threads/…" class="@InputClass" />
                    </Field>

                    @* Asked here rather than left to the manage screen, because a listing without
                       it never reaches the exported index, and an author who finds that out later
                       finds it out from their mod being missing. *@
                    <Field Context="field" Id="game-min" Label="Oldest game build it works on" Required="false"
                           Error="@_gameMinError"
                           Hint="The build you tested on, written the way the game shows it — 2026.8.3.5117 — or a whole month, 2026.8. Without it every client has to ask before installing your mod, because we can't tell them it fits.">
                        <input @attributes="field" @bind="_form.GameMin"
                               placeholder="2026.8.3.5117" class="@InputClass" />
                    </Field>
                </div>
            </Card>

            <div class="flex items-center gap-3">
                <Button Type="submit" Disabled="_submitting || _idError is not null" Pending="_submitting"
                        PendingLabel="Creating…">
                    Create listing
                </Button>
                <Button Href="/mods" Variant="ghost">Cancel</Button>
            </div>
        </EditForm>
    }
</div>

@code {
    private readonly Form _form = new();
    private string? _idError;
    private string? _gameMinError;
    private string? _idPreview;
    private string? _serverError;
    private bool _submitting;
    private bool _ready;

    /// <summary>
    /// Sends anonymous visitors to sign in before the form is ever drawn, and brings them back
    /// here once they have. The API enforces this regardless; this exists so the enforcement
    /// does not arrive as a rejected submission after the work of filling the thing in.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        if (await Api.GetCurrentUserAsync() is null)
        {
            Nav.NavigateTo($"/signin?returnTo={Uri.EscapeDataString("/mods/new")}", forceLoad: false);
            return;
        }

        _ready = true;
    }

    private const string InputClass =
        "w-full rounded-md border border-input bg-background px-3 py-2 text-sm " +
        "placeholder:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 " +
        "focus-visible:outline-ring";

    private string IdInputClass => Cx.Of(InputClass, "font-mono",
        _idError is not null ? "border-severity-error" : null);

    /// <summary>
    /// Validates against the same <see cref="ContentId"/> rules the API enforces - the project
    /// reference means this is literally the same code, not a re-implementation that can drift.
    /// The server still checks; this just avoids a round trip to learn about a trailing dot.
    /// </summary>
    private void ValidateId()
    {
        _idPreview = null;

        if (string.IsNullOrWhiteSpace(_form.Id))
        {
            _idError = null;
            return;
        }

        if (!ContentId.TryParse(_form.Id, out var id, out var reason))
        {
            _idError = reason switch
            {
                IdRejection.Length => "Must be 1 to 64 characters.",
                IdRejection.Boundary => "Must start and end with a letter or digit.",
                IdRejection.Charset => "Only ASCII letters, digits, '.', '-' and '_' are allowed.",
                IdRejection.Reserved => "That name is reserved by the game or by Windows.",
                _ => "Not a valid id.",
            };
            return;
        }

        _idError = null;
        _idPreview = id.Value.Value;
    }

    private async Task SubmitAsync()
    {
        ValidateId();
        if (_idError is not null) return;

        // Checked here as well as by the API so a typo comes back beside the field instead of as
        // a rejected submission. The API is still the authority: a month only resolves there.
        _gameMinError = ValidateBound(_form.GameMin);
        if (_gameMinError is not null) return;

        _submitting = true;
        _serverError = null;

        try
        {
            var links = new Dictionary<string, string>();
            if (!string.IsNullOrWhiteSpace(_form.Forums)) links["forums"] = _form.Forums.Trim();

            var result = await Api.CreateModAsync(new CreateModRequest(
                _form.Id.Trim(), _form.Name.Trim(), _form.Abstract.Trim(), _form.License.Trim(),
                Links: links.Count > 0 ? links : null,
                BannerUrl: string.IsNullOrWhiteSpace(_form.BannerUrl) ? null : _form.BannerUrl.Trim(),
                GameMin: string.IsNullOrWhiteSpace(_form.GameMin) ? null : _form.GameMin.Trim()));

            if (result.Success && result.Id is not null)
            {
                Nav.NavigateTo($"/mods/{result.Id}");
                return;
            }

            // A session can lapse while the form sits open, so the guard above is not the whole
            // story. Say which of the two it is: one is fixed by signing in again, the other by
            // editing a field, and "rejected" told you neither.
            if (result.NeedsSignIn)
            {
                Nav.NavigateTo($"/signin?returnTo={Uri.EscapeDataString("/mods/new")}", forceLoad: false);
                return;
            }

            _serverError = result.Error
                ?? $"The API rejected the listing (HTTP {(int?)result.Status}). Nothing was created.";
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _serverError = "The API didn't respond. Nothing was created.";
        }
        finally
        {
            _submitting = false;
        }
    }

    /// <summary>
    /// Accepts a full game version or a whole month, the two granularities RFC 0031 offers.
    /// Empty is fine here - the bound is not required to create the listing, only to export it.
    /// </summary>
    private static string? ValidateBound(string? value) =>
        string.IsNullOrWhiteSpace(value)
        || KsaVersion.TryParse(value, out _)
        || KsaVersion.TryParseMonth(value, out _)
            ? null
            : "Write it the way the game shows it, such as 2026.8.3.5117, or a whole month, such as 2026.8.";

    private sealed class Form
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Abstract { get; set; } = "";
        public string License { get; set; } = "MIT";
        public string BannerUrl { get; set; } = "";
        public string Forums { get; set; } = "";
        public string GameMin { get; set; } = "";
    }
}
