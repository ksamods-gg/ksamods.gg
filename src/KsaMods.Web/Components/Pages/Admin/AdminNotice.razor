@page "/admin/notice"
@rendermode InteractiveServer
@inject KsaModsApi Api
@inject SiteNoticeCache Notices

<PageTitle>Notice | ksamods.gg</PageTitle>

<AdminFrame Current="notice">
    <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground">
        The strip across the top of every page. Use it for outages, incidents, and anything the
        site itself needs to say. Leave the message empty to take it down.
    </p>

    @if (_error is not null)
    {
        <Alert Variant="error" Class="mt-4">@_error</Alert>
    }
    @if (_saved)
    {
        <Alert Variant="ok" Title="Saved" Class="mt-4">
            @(string.IsNullOrWhiteSpace(_form.Message)
                ? "The notice is down. Nobody will see a banner."
                : "It is up. Everybody sees it on their next page load.")
        </Alert>
    }

    <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)]">
        <Card Header="@(b => b.AddContent(0, "Message"))">
            <div class="space-y-5">
                <Field Context="field" Id="message" Label="What it says" Required="false"
                       Hint="Empty means no banner. 400 characters at most, because it sits above everything else on the page.">
                    <textarea @attributes="field" @bind="_form.Message" rows="3" class="@InputClass"></textarea>
                </Field>

                <Field Context="field" Id="variant" Label="How loud">
                    <select @attributes="field" @bind="_form.Variant" class="@InputClass">
                        <option value="info">Info, for news and planned work</option>
                        <option value="warning">Warning, for degraded service</option>
                        <option value="error">Error, for an outage in progress</option>
                    </select>
                </Field>

                <div class="grid gap-4 sm:grid-cols-2">
                    <Field Context="field" Id="linkText" Label="Link words" Required="false"
                           Hint="Both or neither.">
                        <input @attributes="field" @bind="_form.LinkText" placeholder="Status page"
                               class="@InputClass" />
                    </Field>

                    <Field Context="field" Id="linkHref" Label="Link address" Required="false"
                           Hint="https only.">
                        <input @attributes="field" type="url" @bind="_form.LinkHref"
                               placeholder="https://…" class="@InputClass" />
                    </Field>
                </div>

                <label class="flex items-center gap-2.5 text-sm">
                    <input type="checkbox" @bind="_form.Dismissible"
                           class="size-4 rounded-sm border-input accent-primary" />
                    <span>
                        People can close it
                        <span class="text-muted-foreground">
                            (an outage notice is worth leaving fixed)
                        </span>
                    </span>
                </label>
            </div>

            <div class="mt-6 flex flex-wrap items-center gap-3">
                <Button Size="sm" Disabled="_saving" Pending="_saving" PendingLabel="Saving…"
                        @onclick="SaveAsync">
                    @(string.IsNullOrWhiteSpace(_form.Message) ? "Take it down" : "Put it up")
                </Button>

                @if (!string.IsNullOrWhiteSpace(_form.Message))
                {
                    <Button Size="sm" Variant="ghost" Disabled="_saving" @onclick="ClearAsync">
                        Clear
                    </Button>
                }
            </div>
        </Card>

        @*
            A preview, because the thing being edited is normally invisible: the banner only shows
            once it is live, so without this the only way to see what you wrote is to publish it
            to everybody and look.
        *@
        <Card Header="@(b => b.AddContent(0, "Preview"))">
            @if (string.IsNullOrWhiteSpace(_form.Message))
            {
                <p class="text-sm text-muted-foreground">Nothing. No banner is shown.</p>
            }
            else
            {
                <div class="@PreviewClass rounded-md border px-3 py-2 text-sm">
                    <span>@_form.Message</span>
                    @if (!string.IsNullOrWhiteSpace(_form.LinkText) && !string.IsNullOrWhiteSpace(_form.LinkHref))
                    {
                        <span class="ml-1 font-medium underline underline-offset-4">@_form.LinkText</span>
                    }
                </div>

                <p class="mt-3 text-xs leading-relaxed text-muted-foreground">
                    Editing the words shows it again to people who had already closed the old one,
                    so a corrected notice isn't hidden by the dismissal of the one it replaced.
                </p>
            }
        </Card>
    </div>
</AdminFrame>

@code {
    private readonly NoticeForm _form = new();
    private bool _saving;
    private bool _saved;
    private string? _error;

    private const string InputClass =
        "w-full rounded-md border border-input bg-background px-3 py-2 text-sm " +
        "placeholder:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 " +
        "focus-visible:outline-ring";

    private string PreviewClass => _form.Variant switch
    {
        "error" => "border-severity-error/30 bg-severity-error/10 text-severity-error",
        "warning" => "border-severity-warning/30 bg-severity-warning/10 text-severity-warning",
        _ => "border-border bg-accent text-accent-foreground",
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (await Api.GetNoticeAsync() is { } notice)
            {
                _form.Message = notice.Message;
                _form.Variant = notice.Variant;
                _form.LinkText = notice.LinkText ?? "";
                _form.LinkHref = notice.LinkHref ?? "";
                _form.Dismissible = notice.Dismissible;
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _error = "Could not read the current notice.";
        }
    }

    private Task ClearAsync()
    {
        _form.Message = "";
        _form.LinkText = "";
        _form.LinkHref = "";
        return SaveAsync();
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _saved = false;
        _error = null;

        try
        {
            var result = await Api.SetNoticeAsync(
                _form.Message?.Trim() ?? "", _form.Variant,
                _form.LinkText?.Trim(), _form.LinkHref?.Trim(), _form.Dismissible);

            if (result.Success)
            {
                _saved = true;

                // Drop the cache so the editor sees their own change on the next render rather
                // than waiting out a TTL and wondering whether it saved.
                Notices.Invalidate();
            }
            else
            {
                _error = result.Error ?? "The API refused that.";
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _error = "The API isn't responding. Nothing was changed.";
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class NoticeForm
    {
        public string? Message { get; set; } = "";
        public string Variant { get; set; } = "info";
        public string? LinkText { get; set; } = "";
        public string? LinkHref { get; set; } = "";
        public bool Dismissible { get; set; } = true;
    }
}
