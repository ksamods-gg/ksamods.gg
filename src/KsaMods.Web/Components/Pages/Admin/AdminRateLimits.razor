@page "/admin/limits"
@rendermode InteractiveServer
@inject KsaModsApi Api

<PageTitle>Rate limits | ksamods.gg</PageTitle>

<AdminFrame Current="limits">
    <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground">
        How many requests one caller gets per window. Lower these if the site is being hammered.
        Reads are counted per address, writes per account where there is one, and webhooks per
        sender.
    </p>

    @if (_error is not null)
    {
        <Alert Variant="error" Class="mt-4">@_error</Alert>
    }
    @if (_saved)
    {
        <Alert Variant="ok" Title="Applied" Class="mt-4">
            In effect now, for callers already being counted as well as new ones. Everybody's
            current window restarted, which is what makes that true.
        </Alert>
    }

    @if (_limits is null)
    {
        <p class="mt-6 font-mono text-xs text-muted-foreground">Loading…</p>
    }
    else
    {
        <Card Class="mt-6 max-w-xl">
            <div class="grid gap-5 sm:grid-cols-2">
                <Field Context="field" Id="reads" Label="Reads" Hint="Anonymous catalogue browsing.">
                    <input @attributes="field" type="number" @bind="_form.Reads" class="@InputClass" />
                </Field>

                <Field Context="field" Id="writes" Label="Writes" Hint="Anything that changes something.">
                    <input @attributes="field" type="number" @bind="_form.Writes" class="@InputClass" />
                </Field>

                <Field Context="field" Id="webhooks" Label="Webhooks" Hint="Forge deliveries. A busy morning is normal.">
                    <input @attributes="field" type="number" @bind="_form.Webhooks" class="@InputClass" />
                </Field>

                <Field Context="field" Id="window" Label="Window, seconds" Hint="What all three are counted over.">
                    <input @attributes="field" type="number" @bind="_form.WindowSeconds" class="@InputClass" />
                </Field>
            </div>

            <p class="mt-4 text-xs leading-relaxed text-muted-foreground">
                Between @_limits.Minimum and @_limits.Maximum. There is a floor because a limit of
                nothing locks out everybody including whoever set it, and the way back would be a
                redeploy.
            </p>

            <div class="mt-5 flex flex-wrap items-center gap-3">
                <Button Size="sm" Disabled="_saving" Pending="_saving" PendingLabel="Applying…"
                        @onclick="SaveAsync">
                    Apply
                </Button>
                <span class="font-mono text-xs text-muted-foreground">
                    @(_limits.ChangedAt is { } when
                        ? $"changed {Presentation.Ago(when)}"
                        : "unchanged since startup")
                </span>
            </div>
        </Card>

        <p class="mt-5 max-w-2xl text-xs leading-relaxed text-muted-foreground">
            Changes here last until the API restarts, at which point it goes back to whatever
            configuration says. To make a change permanent, set
            <code class="font-mono">RateLimits__Reads</code>,
            <code class="font-mono">RateLimits__Writes</code>,
            <code class="font-mono">RateLimits__Webhooks</code> or
            <code class="font-mono">RateLimits__WindowSeconds</code> where the service is deployed.
        </p>
    }
</AdminFrame>

@code {
    private RateLimitSettings? _limits;
    private readonly LimitForm _form = new();
    private bool _saving;
    private bool _saved;
    private string? _error;

    private const string InputClass =
        "w-full rounded-md border border-input bg-background px-3 py-2 text-sm tabular " +
        "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _limits = await Api.GetRateLimitsAsync();

            if (_limits is not null)
            {
                _form.Reads = _limits.Reads;
                _form.Writes = _limits.Writes;
                _form.Webhooks = _limits.Webhooks;
                _form.WindowSeconds = _limits.WindowSeconds;
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _error = "Could not read the current limits.";
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _saved = false;
        _error = null;

        try
        {
            var result = await Api.SetRateLimitsAsync(
                _form.Reads, _form.Writes, _form.Webhooks, _form.WindowSeconds);

            if (result.Success)
            {
                _saved = true;
                await LoadAsync();
            }
            else
            {
                _error = result.Error ?? "The API refused that.";
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _error = "The API isn't responding. Nothing was changed.";
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class LimitForm
    {
        public int Reads { get; set; } = 300;
        public int Writes { get; set; } = 60;
        public int Webhooks { get; set; } = 120;
        public int WindowSeconds { get; set; } = 60;
    }
}
