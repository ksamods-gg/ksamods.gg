@page "/admin/reports"
@rendermode InteractiveServer
@inject KsaModsApi Api

<PageTitle>Reports | ksamods.gg</PageTitle>

<AdminFrame Current="reports">
    <div class="flex flex-wrap items-center gap-2">
        @foreach (var filter in Filters)
        {
            <Button Type="button" Size="sm"
                    Variant="@(_state == filter.Value ? "default" : "outline")"
                    @onclick="() => FilterAsync(filter.Value)">
                @filter.Label
            </Button>
        }
    </div>

    @if (_error is not null)
    {
        <Alert Variant="error" Class="mt-4">@_error</Alert>
    }

    @if (_notice is not null)
    {
        <Alert Variant="ok" Class="mt-4">@_notice</Alert>
    }

    @if (_loading)
    {
        <p class="mt-6 text-sm text-muted-foreground">Loading…</p>
    }
    else if (_reports.Count == 0)
    {
        <Card Class="mt-4">
            <p class="text-sm text-muted-foreground">
                @(_state == "open" ? "No open reports. Nothing is waiting on you."
                                   : "No reports match that filter.")
            </p>
        </Card>
    }
    else
    {
        <ul class="mt-4 space-y-3">
            @foreach (var report in _reports)
            {
                <li>
                    <Card Padded="false">
                        <div class="px-5 py-4">
                            <div class="flex flex-wrap items-center gap-2">
                                <Badge Variant="@CategoryVariant(report.Category)">@report.Category</Badge>
                                <Badge Variant="outline">@report.SubjectKind</Badge>

                                @if (report.SubjectKind == "mod")
                                {
                                    <a href="@($"/mods/{report.SubjectId}")"
                                       class="font-mono text-sm underline-offset-4 hover:underline">
                                        @report.SubjectId
                                    </a>
                                }
                                else
                                {
                                    <code class="font-mono text-sm">@report.SubjectId</code>
                                }

                                @if (!report.IsOpen)
                                {
                                    <Badge Variant="ok">@report.State</Badge>
                                }

                                <span class="ml-auto text-xs text-muted-foreground">
                                    @Presentation.Ago(report.CreatedAt)
                                    @if (report.ReporterHandle is { Length: > 0 })
                                    {
                                        <text> · by @@@report.ReporterHandle</text>
                                    }
                                    else
                                    {
                                        @* The reporter may have deleted their account since. *@
                                        <text> · reporter unknown</text>
                                    }
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(report.Body))
                            {
                                @* Plain text, never markup: this is a stranger's words, quoted. *@
                                <p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed">@report.Body</p>
                            }
                            else
                            {
                                <p class="mt-3 text-sm italic text-muted-foreground">
                                    No description given.
                                </p>
                            }

                            @if (!report.IsOpen)
                            {
                                <p class="mt-3 text-xs text-muted-foreground">
                                    @report.State
                                    @if (report.ResolvedBy is { Length: > 0 })
                                    {
                                        <text> by @@@report.ResolvedBy</text>
                                    }
                                    @if (report.ResolvedAt is { } at)
                                    {
                                        <text> · @Presentation.Ago(at)</text>
                                    }
                                    ·
                                    <a href="@($"/admin/log?subjectId={Uri.EscapeDataString(report.SubjectId)}")"
                                       class="underline underline-offset-4">see the log entry</a>
                                </p>
                            }
                        </div>

                        @if (report.IsOpen)
                        {
                            <div class="border-t border-border bg-card/50 px-5 py-4">
                                <label class="eyebrow text-muted-foreground" for="@($"why-{report.Id}")">
                                    Reason
                                </label>
                                <textarea id="@($"why-{report.Id}")" rows="2"
                                          value="@Rationale(report.Id)"
                                          @oninput="e => SetRationale(report.Id, e.Value?.ToString())"
                                          placeholder="What you found, and what you did about it."
                                          class="@Cx.Of(TextareaClass, _blank == report.Id ? "border-severity-error" : null)"></textarea>

                                @* Beside the box it is about. At the top of the page it sat above
                                   a row of filter buttons, which is not what it was talking about. *@
                                @if (_blank == report.Id)
                                {
                                    <p class="mt-1.5 text-xs text-severity-error">
                                        Write down why first. It goes in the log with your name on it.
                                    </p>
                                }

                                <div class="mt-3 flex flex-wrap items-center gap-2">
                                    @* Three outcomes, deliberately: "triaged" is for a report that
                                       is real and being worked, so a queue does not have to choose
                                       between pretending it is done and leaving it looking
                                       untouched. *@
                                    <Button Type="button" Size="sm" Variant="outline"
                                            Disabled="@Busy(report.Id)"
                                            @onclick='() => ResolveAsync(report.Id, "triaged")'>
                                        Looking into it
                                    </Button>
                                    <Button Type="button" Size="sm"
                                            Disabled="@Busy(report.Id)"
                                            @onclick='() => ResolveAsync(report.Id, "actioned")'>
                                        Acted on it
                                    </Button>
                                    <Button Type="button" Size="sm" Variant="ghost"
                                            Disabled="@Busy(report.Id)"
                                            @onclick='() => ResolveAsync(report.Id, "dismissed")'>
                                        Nothing to do
                                    </Button>

                                    @if (report.SubjectKind == "mod")
                                    {
                                        <a href="@($"/admin/listings?q={Uri.EscapeDataString(report.SubjectId)}")"
                                           class="ml-auto text-xs text-muted-foreground underline underline-offset-4 hover:text-foreground">
                                            Withdraw the listing →
                                        </a>
                                    }
                                </div>

                                <p class="mt-2 text-xs text-muted-foreground">
                                    Closing a report does not change the listing. If it needs
                                    withdrawing, do that first.
                                </p>
                            </div>
                        }
                    </Card>
                </li>
            }
        </ul>
    }
</AdminFrame>

@code {
    private const string TextareaClass =
        "mt-1 w-full rounded-md border border-input bg-background px-3 py-2 text-sm " +
        "placeholder:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 " +
        "focus-visible:outline-ring";

    private static readonly (string Label, string Value)[] Filters =
    [
        ("Open", "open"),
        ("Looking into it", "triaged"),
        ("Acted on", "actioned"),
        ("Dismissed", "dismissed"),
        ("Everything", ""),
    ];

    private IReadOnlyList<AdminReport> _reports = [];
    private readonly Dictionary<long, string> _rationales = [];
    private long? _busy;

    /// <summary>The report whose reason box was left empty, so the complaint can sit next to it.</summary>
    private long? _blank;

    private string _state = "open";
    private bool _loading = true;
    private string? _error;
    private string? _notice;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            _reports = await Api.GetReportsAsync(_state) ?? [];
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _reports = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task FilterAsync(string state)
    {
        _state = state;
        _notice = null;
        _error = null;
        await LoadAsync();
    }

    private string Rationale(long id) => _rationales.GetValueOrDefault(id, "");

    private void SetRationale(long id, string? value) => _rationales[id] = value ?? "";

    private bool Busy(long id) => _busy == id;

    private async Task ResolveAsync(long id, string state)
    {
        var rationale = Rationale(id).Trim();

        // Checked here as well as in the API, so the reason box is refused before the round trip
        // rather than after it - the text is the whole point of the record.
        if (rationale.Length == 0)
        {
            _blank = id;
            _notice = null;
            return;
        }

        _busy = id;
        _blank = null;
        _error = null;
        _notice = null;

        try
        {
            var result = await Api.ResolveReportAsync(id, state, rationale);

            if (result.Success)
            {
                _rationales.Remove(id);
                _notice = "Report closed and logged.";
                await LoadAsync();
            }
            else
            {
                _error = result.Error ?? "Could not close that report.";
            }
        }
        finally
        {
            _busy = null;
        }
    }

    private static string CategoryVariant(string category) => category switch
    {
        "malware" => "error",
        "stolen" => "warning",
        "broken" => "info",
        _ => "outline",
    };
}
