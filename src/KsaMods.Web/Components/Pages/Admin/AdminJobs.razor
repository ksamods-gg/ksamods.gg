@page "/admin/jobs"
@rendermode InteractiveServer
@inject KsaModsApi Api

<PageTitle>Jobs | ksamods.gg</PageTitle>

<AdminFrame Current="jobs">
    <p class="text-sm leading-relaxed text-muted-foreground">
        Background work: importing releases, re-checking that download links still hold the file we
        recorded, and rebuilding the exported index. Finished jobs are not listed - only the ones
        somebody might need to do something about.
    </p>

    @if (_error is not null)
    {
        <Alert Variant="error" Class="mt-4">@_error</Alert>
    }

    @if (_notice is not null)
    {
        <Alert Variant="ok" Class="mt-4">@_notice</Alert>
    }

    <div class="mt-4">
        <Button Type="button" Size="sm" Variant="outline" @onclick="LoadAsync">Refresh</Button>
    </div>

    @if (_loading)
    {
        <p class="mt-6 text-sm text-muted-foreground">Loading…</p>
    }
    else if (_jobs.Count == 0)
    {
        <Card Class="mt-4">
            <p class="text-sm text-muted-foreground">
                The queue is empty and nothing has failed.
            </p>
        </Card>
    }
    else
    {
        <div class="mt-4 overflow-x-auto rounded-lg border border-border">
            <table class="w-full text-sm">
                <thead class="border-b border-border bg-card/50 text-left">
                    <tr class="eyebrow text-muted-foreground">
                        <th class="px-4 py-2 font-normal">State</th>
                        <th class="px-4 py-2 font-normal">Kind</th>
                        <th class="px-4 py-2 font-normal">Tries</th>
                        <th class="px-4 py-2 font-normal">Queued</th>
                        <th class="px-4 py-2 font-normal">Next run</th>
                        <th class="px-4 py-2 font-normal"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border">
                    @foreach (var job in _jobs)
                    {
                        <tr>
                            <td class="px-4 py-2.5 align-top">
                                <Badge Variant="@StateVariant(job.State)">@job.State</Badge>
                            </td>
                            <td class="px-4 py-2.5 align-top">
                                <span class="font-mono text-xs">@job.Kind</span>
                                @if (!string.IsNullOrWhiteSpace(job.LastError))
                                {
                                    @* The error is why anyone opened this page. Retrying without
                                       reading it just burns the attempt again. *@
                                    <p class="mt-1 max-w-xl whitespace-pre-wrap break-words text-xs text-severity-error">
                                        @job.LastError
                                    </p>
                                }
                            </td>
                            <td class="px-4 py-2.5 align-top font-mono text-xs">@job.Attempts</td>
                            <td class="px-4 py-2.5 align-top text-xs text-muted-foreground">
                                @Presentation.Ago(job.CreatedAt)
                            </td>
                            <td class="px-4 py-2.5 align-top text-xs text-muted-foreground">
                                @(job.RunAfter <= DateTimeOffset.UtcNow ? "due" : job.RunAfter.ToString("HH:mm"))
                            </td>
                            <td class="px-4 py-2.5 align-top text-right">
                                @if (job.CanRetry)
                                {
                                    <Button Type="button" Size="sm" Variant="outline"
                                            Disabled="@(_busy == job.Id)"
                                            @onclick="() => RetryAsync(job)">
                                        Retry
                                    </Button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="mt-3 text-xs text-muted-foreground">
            Retrying resets the attempt count, so a job whose cause has been fixed gets its full
            backoff budget rather than dying again on the first hiccup. It is not logged as a
            moderation action - it changes nothing anyone can see.
        </p>
    }
</AdminFrame>

@code {
    private IReadOnlyList<AdminJob> _jobs = [];
    private long? _busy;

    private bool _loading = true;
    private string? _error;
    private string? _notice;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            _jobs = await Api.GetJobsAsync() ?? [];
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _jobs = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RetryAsync(AdminJob job)
    {
        _busy = job.Id;
        _error = null;
        _notice = null;

        try
        {
            var result = await Api.RetryJobAsync(job.Id);

            if (result.Success)
            {
                _notice = $"Job #{job.Id} is queued again.";
                await LoadAsync();
            }
            else
            {
                _error = result.Error ?? "Could not requeue that job.";
            }
        }
        finally
        {
            _busy = null;
        }
    }

    private static string StateVariant(string state) => state switch
    {
        "dead" => "error",
        "failed" => "warning",
        "running" => "info",
        _ => "outline",
    };
}
