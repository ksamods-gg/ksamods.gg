@page "/admin/reviews"
@rendermode InteractiveServer
@inject KsaModsApi Api

<PageTitle>Review queue | ksamods.gg</PageTitle>

<AdminFrame Current="reviews">
    <p class="text-sm leading-relaxed text-muted-foreground">
        Releases nobody has looked at yet, because they ship a managed assembly, run console
        commands at a game hook, or changed after we imported them. Validation says a package is
        well formed. It can't say the code inside it is safe, and this queue is the part where a
        person does.
    </p>

    @if (_error is not null)
    {
        <Alert Variant="error" Class="mt-4">@_error</Alert>
    }

    @if (_notice is not null)
    {
        <Alert Variant="ok" Class="mt-4">@_notice</Alert>
    }

    @if (_loading)
    {
        <p class="mt-6 text-sm text-muted-foreground">Loading…</p>
    }
    else if (_queue.Count == 0)
    {
        <Card Class="mt-4">
            <p class="text-sm text-muted-foreground">
                Nothing waiting. Every release that ships code has been looked at.
            </p>
        </Card>
    }
    else
    {
        <ul class="mt-4 space-y-3">
            @foreach (var review in _queue)
            {
                <li>
                    <Card Padded="false">
                        <div class="px-5 py-4">
                            <div class="flex flex-wrap items-baseline gap-2">
                                <a href="@($"/mods/{review.ModId}/releases/{review.Version}")"
                                   class="font-medium underline-offset-4 hover:underline">
                                    @review.ModName
                                </a>
                                <code class="font-mono text-xs text-muted-foreground">
                                    @review.ModId@("@")@review.Version
                                </code>
                                <span class="ml-auto text-xs text-muted-foreground">
                                    released @Presentation.Ago(review.ReleasedAt)
                                </span>
                            </div>

                            @* Why it is here, in order of how much it should worry you. *@
                            <div class="mt-3 flex flex-wrap items-center gap-1.5">
                                @if (review.Quarantined)
                                {
                                    <Badge Variant="error" Title="The file at the link isn't the one we imported.">
                                        quarantined
                                    </Badge>
                                }
                                @if (review.ShipsCode)
                                {
                                    <Badge Variant="warning" Title="Contains a .NET assembly. It runs with full access to the player's machine.">
                                        ships code
                                    </Badge>
                                }
                                @if (review.RunsConsole)
                                {
                                    <Badge Variant="warning" Title="Runs console commands at onBoot or onLoad.">
                                        console commands
                                    </Badge>
                                }
                                @if (review.OpenReports > 0)
                                {
                                    <Badge Variant="error">@review.OpenReports open report@(review.OpenReports == 1 ? "" : "s")</Badge>
                                }
                                @if (review.Warnings > 0)
                                {
                                    <Badge Variant="outline">@review.Warnings warning@(review.Warnings == 1 ? "" : "s")</Badge>
                                }
                                <Badge Variant="outline">@review.ValidationState</Badge>
                            </div>
                        </div>

                        <div class="border-t border-border bg-card/50 px-5 py-4">
                            <div class="flex flex-wrap items-center gap-2">
                                <Button Href="@($"/mods/{review.ModId}/releases/{review.Version}")"
                                        Variant="outline" Size="sm">
                                    Open the release
                                </Button>
                                <Button Type="button" Size="sm" Disabled="@(_busy == review.Id)"
                                        @onclick="() => ClearAsync(review)">
                                    Looks fine
                                </Button>
                                <a href="@($"/admin/listings?q={Uri.EscapeDataString(review.ModId)}")"
                                   class="text-xs text-muted-foreground underline underline-offset-4 hover:text-foreground">
                                    Withdraw the listing →
                                </a>
                            </div>

                            <input value="@Notes(review.Id)"
                                   @oninput="e => SetNotes(review.Id, e.Value?.ToString())"
                                   placeholder="Notes, if there's anything worth saying (optional)"
                                   class="@InputClass" />

                            <p class="mt-2 text-xs text-muted-foreground">
                                "Looks fine" records that you read it. It doesn't change anything
                                about the release, and it takes it out of this queue for good.
                            </p>
                        </div>
                    </Card>
                </li>
            }
        </ul>
    }
</AdminFrame>

@code {
    private const string InputClass =
        "mt-3 w-full rounded-md border border-input bg-background px-3 py-2 text-sm " +
        "placeholder:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 " +
        "focus-visible:outline-ring";

    private IReadOnlyList<AdminReview> _queue = [];
    private readonly Dictionary<long, string> _notes = [];
    private long? _busy;

    private bool _loading = true;
    private string? _error;
    private string? _notice;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            _queue = await Api.GetReviewQueueAsync() ?? [];
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _queue = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private string Notes(long id) => _notes.GetValueOrDefault(id, "");

    private void SetNotes(long id, string? value) => _notes[id] = value ?? "";

    private async Task ClearAsync(AdminReview review)
    {
        _busy = review.Id;
        _error = null;
        _notice = null;

        try
        {
            var notes = Notes(review.Id).Trim();
            var result = await Api.ClearReviewAsync(review.Id, notes.Length == 0 ? null : notes);

            if (result.Success)
            {
                _notes.Remove(review.Id);
                _notice = $"{review.ModId}@{review.Version} marked as reviewed.";
                await LoadAsync();
            }
            else
            {
                _error = result.Error ?? "Could not record that review.";
            }
        }
        finally
        {
            _busy = null;
        }
    }
}
