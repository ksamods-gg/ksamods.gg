@page "/admin/log"
@rendermode InteractiveServer
@inject KsaModsApi Api

<PageTitle>Moderation log | ksamods.gg</PageTitle>

<AdminFrame Current="log">
    <p class="text-sm leading-relaxed text-muted-foreground">
        Every moderation action, in order, with who did it and why. Entries cannot be edited or
        removed - the database refuses. A correction is a new entry pointing at the one it replaces,
        so the record shows the mistake and the fix rather than only the fix.
    </p>

    <div class="mt-4 flex flex-wrap items-end gap-3">
        <div class="min-w-56 flex-1">
            <label class="eyebrow text-muted-foreground" for="subject">Filter by subject</label>
            <input id="subject" value="@_subject" @oninput='e => _subject = e.Value?.ToString() ?? ""'
                   @onkeydown="OnKeyDownAsync" placeholder="A mod id, or a handle"
                   class="@InputClass" autocomplete="off" spellcheck="false" />
        </div>
        <Button Type="button" Size="sm" @onclick="LoadAsync">Filter</Button>
        @if (!string.IsNullOrWhiteSpace(_subject))
        {
            <Button Type="button" Size="sm" Variant="ghost" @onclick="ClearAsync">Clear</Button>
        }
    </div>

    @if (_loading)
    {
        <p class="mt-6 text-sm text-muted-foreground">Loading…</p>
    }
    else if (_entries.Count == 0)
    {
        <Card Class="mt-4">
            <p class="text-sm text-muted-foreground">
                @(string.IsNullOrWhiteSpace(_subject)
                    ? "Nothing has been moderated yet."
                    : "No entries for that subject.")
            </p>
        </Card>
    }
    else
    {
        <ol class="mt-4 space-y-2">
            @foreach (var entry in _entries)
            {
                <li class="rounded-lg border border-border bg-card px-4 py-3">
                    <div class="flex flex-wrap items-center gap-2">
                        <Badge Variant="@ActionVariant(entry.Action)">@entry.Action</Badge>
                        <Badge Variant="outline">@entry.SubjectKind</Badge>

                        <button type="button" @onclick="() => FilterToAsync(entry.SubjectId)"
                                class="font-mono text-sm underline-offset-4 hover:underline">
                            @entry.SubjectId
                        </button>

                        @if (!entry.Public)
                        {
                            <Badge Variant="warning" Title="Not shown on the public record.">internal</Badge>
                        }

                        @if (entry.Supersedes is { } superseded)
                        {
                            <Badge Variant="info" Title="@($"Replaces entry #{superseded}")">
                                supersedes #@superseded
                            </Badge>
                        }

                        <span class="ml-auto text-xs text-muted-foreground">
                            @(entry.ActorHandle is { Length: > 0 } ? $"@{entry.ActorHandle}" : "removed account")
                            · @Presentation.Ago(entry.CreatedAt)
                            · <span title="@entry.CreatedAt.ToString("u")">#@entry.Id</span>
                        </span>
                    </div>

                    @* The reason is the substance of the entry, so it gets the body position and
                       plain type rather than being tucked into a metadata line. *@
                    <p class="mt-2 whitespace-pre-wrap text-sm leading-relaxed">@entry.Rationale</p>
                </li>
            }
        </ol>
    }
</AdminFrame>

@code {
    private const string InputClass =
        "mt-1 w-full rounded-md border border-input bg-background px-3 py-2 text-sm " +
        "placeholder:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 " +
        "focus-visible:outline-ring";

    [SupplyParameterFromQuery] public string? SubjectId { get; set; }

    private IReadOnlyList<ModerationEntry> _entries = [];
    private string _subject = "";
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _subject = SubjectId ?? "";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            _entries = await Api.GetModerationLogAsync(
                string.IsNullOrWhiteSpace(_subject) ? null : _subject.Trim()) ?? [];
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _entries = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task ClearAsync()
    {
        _subject = "";
        await LoadAsync();
    }

    /// <summary>Clicking a subject shows its whole history - which is the question people ask.</summary>
    private async Task FilterToAsync(string subjectId)
    {
        _subject = subjectId;
        await LoadAsync();
    }

    private static string ActionVariant(string action) =>
        action.StartsWith("listing_taken_down", StringComparison.Ordinal)
        || action.StartsWith("listing_delisted", StringComparison.Ordinal)
        || action.StartsWith("account_suspended", StringComparison.Ordinal) ? "error"
        : action.StartsWith("role_", StringComparison.Ordinal) ? "info"
        : action.StartsWith("review_", StringComparison.Ordinal) ? "outline"
        : "neutral";
}
