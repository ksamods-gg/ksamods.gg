@page "/mods/{Id}/releases/{Version}"
@inject KsaModsApi Api

<PageTitle>@Id @Version | ksamods.gg</PageTitle>

@if (_error is not null)
{
    <Alert Variant="error" Title="Could not load this release">@_error</Alert>
}
else if (_notFound)
{
    @* Same treatment as the listing's own miss state: a version that never existed, or one that
       was never stamped, should still land on a headed page rather than a bare card. *@
    <Card Class="mx-auto max-w-md text-center">
        <h1 class="text-lg font-semibold tracking-tight">This release isn't here</h1>
        <p class="mt-2 text-sm text-muted-foreground">
            No release <code class="font-mono">@Version</code> of <code class="font-mono">@Id</code>.
        </p>
        <Button Href="@($"/mods/{Id}")" Variant="outline" Size="sm" Class="mt-4">Back to the mod</Button>
    </Card>
}
else if (_release is null)
{
    <p class="text-sm text-muted-foreground">Loading…</p>
}
else
{
    @* Named, because it is the third navigation landmark on this page and the only one that was
       anonymous in the list - "navigation" twice over and one unlabelled is not an outline. *@
    <nav aria-label="Breadcrumb" class="mb-4 text-sm text-muted-foreground">
        <a href="@($"/mods/{Id}")" class="inline-flex min-h-6 items-center underline-offset-4 hover:underline">@Id</a>
        <span class="mx-1.5">/</span>
        <span class="font-mono">@_release.Version</span>
    </nav>

    <header class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="font-mono text-2xl font-semibold tracking-tight">@_release.Version</h1>
            <p class="mt-1 text-sm text-muted-foreground">
                Released @Presentation.Ago(_release.ReleasedAt)
                · @Presentation.ReleaseChannel(_release.ReleaseStatus)
                @if (_release.InstallSize is not null)
                {
                    <span> · @Presentation.Bytes(_release.InstallSize) installed</span>
                }
            </p>
        </div>

        <div class="flex shrink-0 flex-col items-end gap-2">
            @if (_release.Yanked)
            {
                <Badge Variant="error">Yanked</Badge>
            }
            else if (_release.Download is not null && _release.Availability != "quarantined")
            {
                <Button Href="@_release.Download.Url" Variant="primary">Download</Button>
            }
            <PillBadge Value="@Presentation.Availability(_release.Availability, _release.LastVerifiedAt)" />
        </div>
    </header>

    @if (_release.Yanked)
    {
        <Alert Variant="error" Title="The author has retracted this release" Class="mt-4">
            @(_release.YankedReason ?? "No reason was given.")
            <p class="mt-2">
                We aren't offering it for new installs. A copy you already have is fine: the site
                can't reach into your game, and wouldn't want to.
            </p>
        </Alert>
    }
    else if (_release.Availability == "quarantined")
    {
        <Alert Variant="error" Title="Download withheld pending review" Class="mt-4">
            The file behind this link has changed since we imported it, and not in a small way:
            different assemblies, console commands or asset ids. That is what a compromised
            release looks like, so we're hiding the download until someone has looked at it.
        </Alert>
    }

    <div class="mt-6 grid gap-6 lg:grid-cols-3">
        <div class="space-y-6 lg:col-span-2">

            <Card Header="@(b => b.AddContent(0, "Validation"))"
                  Description="@(b => b.AddContent(0, "What the archive contained when it was imported"))">
                <Actions>
                    <PillBadge Value="@Presentation.Validation(_release.ValidationState)" />
                </Actions>
                <ChildContent>
                    <FindingList Findings="_release.Findings" />
                </ChildContent>
            </Card>

            @* Renders nothing for anybody who is not staff. Reloads the card above when it changes
               something, so a moderator sees the reader's view of their own decision. *@
            <FindingModeration ModId="@Id" Version="@Version" Changed="ReloadAsync" />

            @if (_release.Console.Count > 0)
            {
                @* The single most direct scripted-behaviour vector in a mod.toml. Shown verbatim
                   and never summarised: an abbreviated command is not a disclosure. *@
                <Card Header="@(b => b.AddContent(0, "Runs console commands automatically"))"
                      Description="@(b => b.AddContent(0, $"{_release.Console.Count} command(s) from [console] in mod.toml"))">
                    <ul class="space-y-2">
                        @foreach (var command in _release.Console)
                        {
                            <li class="flex gap-3 text-sm">
                                <Badge Variant="warning" Class="shrink-0">@command.Hook</Badge>
                                <code class="font-mono break-all">@command.Command</code>
                            </li>
                        }
                    </ul>
                </Card>
            }

            @if (_release.Dependencies.Count > 0)
            {
                <Card Header="@(b => b.AddContent(0, "Dependencies"))">
                    <ul class="divide-y divide-border">
                        @foreach (var dependency in _release.Dependencies)
                        {
                            <li class="flex flex-wrap items-center gap-2 py-2 text-sm first:pt-0 last:pb-0">
                                <a href="@($"/mods/{dependency.Id}")"
                                   class="inline-flex min-h-6 items-center font-mono underline-offset-4 hover:underline">@dependency.Id</a>
                                <Badge Variant="@(dependency.Kind == "conflict" ? "error" : "outline")">
                                    @dependency.Kind
                                </Badge>
                                @if (dependency.Min is not null || dependency.Max is not null)
                                {
                                    <span class="text-xs text-muted-foreground">
                                        @(dependency.Min is not null ? $"≥{dependency.Min}" : "")
                                        @(dependency.Max is not null ? $"≤{dependency.Max}" : "")
                                    </span>
                                }
                                @if (dependency.Source == "derived")
                                {
                                    @* Derived entries came from the archive's own [StarMap] section,
                                       which the loader acts on at runtime - so they are ground truth,
                                       not something the author typed. *@
                                    <Badge Variant="info" Title="Read from the archive's own mod.toml, so the loader will act on it regardless of what the index says.">
                                        from mod.toml
                                    </Badge>
                                }
                            </li>
                        }
                    </ul>
                </Card>
            }
        </div>

        <aside class="space-y-6">
            <Card Header="@(b => b.AddContent(0, "Compatibility"))">
                @* The version strings go in as well as the revisions, so the pill says the same
                   thing the two rows underneath it say rather than quoting a build counter. *@
                <PillBadge Value="@Presentation.Compatibility(
                                      null, _release.GameMinRevision, _release.GameMaxRevision,
                                      _release.GameMin, _release.GameMax)" />

                <dl class="mt-3 space-y-1.5 text-sm">
                    <div class="flex justify-between gap-4">
                        <dt class="text-muted-foreground">Oldest tested</dt>
                        <dd class="font-mono">@(_release.GameMin ?? "not set")</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-muted-foreground">Newest tested</dt>
                        <dd class="font-mono">@(_release.GameMax ?? "open")</dd>
                    </div>
                </dl>

                @if (_release.GameMax is null && _release.GameMin is not null)
                {
                    <p class="mt-3 text-xs text-muted-foreground">
                        An open upper bound just means the author hasn't hit a build where it breaks. It isn't a
                        promise that it'll keep working.
                    </p>
                }
            </Card>

            @if (_release.Loader is not null)
            {
                <Card Header="@(b => b.AddContent(0, "Loader"))">
                    @* This one keeps its 18px height on purpose, unlike the breadcrumb and the
                       dependency list above. It sits inside a sentence, which is the case WCAG
                       2.2 exempts from the 24px target minimum by name, and boxing it to clear
                       that floor would push it off the baseline of the words either side of it. *@
                    <p class="text-sm">
                        Needs <a href="@($"/mods/{_release.Loader.Id}")"
                                 class="font-mono underline underline-offset-4">@_release.Loader.Id</a>
                        @(_release.Loader.Min is not null ? $" {_release.Loader.Min} or newer" : "")
                    </p>
                    <p class="mt-2 text-xs text-muted-foreground">
                        This is a code mod. It runs as an unsandboxed .NET assembly with the same
                        privileges as the game.
                    </p>
                </Card>
            }

            @if (_release.Download is not null)
            {
                <Card Header="@(b => b.AddContent(0, "File"))">
                    <dl class="space-y-1.5 text-sm">
                        <div class="flex justify-between gap-4">
                            <dt class="text-muted-foreground">Size</dt>
                            <dd>@Presentation.Bytes(_release.Download.Size)</dd>
                        </div>
                    </dl>

                    @* The hash is the whole integrity story: the site does not host the file, so
                       this is what lets a client prove it got the reviewed bytes. Shown in full on
                       demand rather than truncated away. *@
                    <div class="mt-3">
                        <p class="text-xs text-muted-foreground">SHA-256</p>
                        <code class="mt-1 block font-mono text-xs break-all"
                              title="@_release.Download.Sha256">@_release.Download.Sha256</code>
                    </div>

                    <p class="mt-3 text-xs text-muted-foreground">
                        Hosted by the author, not by ksamods.gg. A conforming client verifies this
                        hash after downloading and refuses to install on a mismatch.
                    </p>
                </Card>
            }
        </aside>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public string Version { get; set; } = "";

    private ReleaseDetail? _release;
    private bool _notFound;
    private string? _error;

    protected override Task OnParametersSetAsync()
    {
        _release = null;
        return ReloadAsync();
    }

    /// <summary>
    /// Also called by the staff finding controls after they change something, so a moderator sees
    /// the reader's view of their own decision rather than having to reload the page to trust it.
    /// </summary>
    private async Task ReloadAsync()
    {
        _error = null;
        _notFound = false;

        try
        {
            _release = await Api.GetReleaseAsync(Id, Version);
            _notFound = _release is null;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _error = "The API didn't respond.";
        }
    }
}
