@page "/u/{Handle}"
@using KsaMods.Web.Components.Domain
@inject KsaModsApi Api

<PageTitle>@(_profile?.DisplayName ?? Handle) | ksamods.gg</PageTitle>

@if (_loading)
{
    <p class="font-mono text-xs text-muted-foreground">Loading…</p>
}
else if (_profile is null)
{
    @* Headed, like every other terminal state. A handle that no longer resolves is a link
       somebody followed, not a mistake they made. *@
    <Card Class="mx-auto max-w-md text-center">
        <h1 class="text-lg font-semibold tracking-tight">Nobody here by that name</h1>
        <p class="mt-2 text-sm text-muted-foreground">
            No account with the handle <code class="font-mono">@Handle</code>.
        </p>
        <Button Href="/mods" Variant="outline" Size="sm" Class="mt-4">Browse mods</Button>
    </Card>
}
else
{
    <div class="mx-auto max-w-4xl">
        <header class="flex flex-wrap items-start gap-5 border-b border-border pb-6">
            @if (!string.IsNullOrWhiteSpace(_profile.AvatarUrl))
            {
                <img src="@_profile.AvatarUrl" alt="" width="72" height="72"
                     class="size-18 shrink-0 rounded-full border border-border object-cover"
                     referrerpolicy="no-referrer" />
            }
            else
            {
                <span class="flex size-18 shrink-0 items-center justify-center rounded-full border
                             border-border bg-secondary font-display text-2xl font-semibold
                             text-muted-foreground" aria-hidden="true">
                    @_profile.DisplayName[..1].ToUpperInvariant()
                </span>
            }

            <div class="min-w-0 flex-1">
                <h1 class="text-2xl font-bold tracking-tight">@_profile.DisplayName</h1>
                <code class="mt-0.5 block font-mono text-sm text-muted-foreground">@@@_profile.Handle</code>

                @if (!string.IsNullOrWhiteSpace(_profile.Bio))
                {
                    @* Plain text, never markup. This is user input rendered to strangers, which
                       makes it the likeliest XSS vector on a public page. *@
                    <p class="mt-3 max-w-2xl whitespace-pre-wrap text-sm leading-relaxed">@_profile.Bio</p>
                }

                @if (AllLinks.Count > 0)
                {
                    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-sm">
                        @foreach (var (label, url) in AllLinks)
                        {
                            @* rel="nofollow" as well as noreferrer: these are links anybody with an
                               account can publish, and this page should not lend them ranking. *@
                            <a href="@url" rel="nofollow noreferrer" target="_blank"
                               class="text-primary underline-offset-4 hover:underline">@label</a>
                        }
                    </div>
                }
            </div>

            <dl class="flex shrink-0 gap-6 text-right tabular">
                <div>
                    <dt class="field-label text-muted-foreground">Mods</dt>
                    <dd class="mt-1 font-mono text-lg">@_profile.Mods.Count</dd>
                </div>
            </dl>
        </header>

        <section class="mt-8">
            <h2 class="field-label text-muted-foreground">Published mods</h2>

            @if (_profile.Mods.Count == 0)
            {
                <Card Class="mt-4">
                    <p class="text-sm text-muted-foreground">
                        Nothing published yet. Drafts stay private until their author publishes them.
                    </p>
                </Card>
            }
            else
            {
                <div class="mt-4 grid items-start gap-4 sm:grid-cols-2">
                    @foreach (var mod in _profile.Mods)
                    {
                        <a href="@($"/mods/{mod.Id}")"
                           class="group flex gap-3 rounded-lg border border-border bg-card p-4
                                  transition-colors hover:border-primary/50
                                  focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
                            <ModIcon Id="@mod.Id" IconUrl="@mod.IconUrl" />

                            <div class="min-w-0 flex-1">
                                <div class="flex items-start justify-between gap-2">
                                    <h3 class="truncate text-[0.9375rem] font-semibold leading-tight
                                               transition-colors group-hover:text-primary">@mod.Name</h3>
                                    @if (mod.Type == "mod-loader")
                                    {
                                        <Badge Variant="info" Class="shrink-0">loader</Badge>
                                    }
                                </div>

                                <p class="mt-1.5 line-clamp-2 text-[0.8125rem] leading-relaxed text-muted-foreground">
                                    @mod.Abstract
                                </p>

                                <div class="mt-2.5 flex items-center font-mono text-[0.6875rem] text-muted-foreground tabular">
                                    <span class="ml-auto">@Presentation.Ago(mod.UpdatedAt)</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    [Parameter] public string Handle { get; set; } = "";

    private PublicProfile? _profile;
    private bool _loading = true;

    /// <summary>
    /// The forums thread sits alongside whatever else they added rather than in a field of its
    /// own: to a reader it is just another place to find them, and giving it separate billing
    /// says more about our schema than about the person.
    /// </summary>
    private IReadOnlyList<(string Label, string Url)> AllLinks
    {
        get
        {
            var links = new List<(string, string)>();

            if (!string.IsNullOrWhiteSpace(_profile?.ForumsUrl))
            {
                links.Add(("KSA forums", _profile.ForumsUrl));
            }

            foreach (var (label, url) in _profile?.Links ?? [])
            {
                if (!string.IsNullOrWhiteSpace(url)) links.Add((label, url));
            }

            return links;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;

        try
        {
            _profile = await Api.GetPublicProfileAsync(Handle);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _profile = null;
        }
        finally
        {
            _loading = false;
        }
    }
}
