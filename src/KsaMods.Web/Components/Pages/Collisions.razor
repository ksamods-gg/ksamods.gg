@page "/collisions"
@page "/collisions/{AssetId}"
@inject KsaModsApi Api

<PageTitle>Asset id collisions — ksamods.gg</PageTitle>

<h1 class="text-2xl font-semibold tracking-tight">Asset id collisions</h1>

<p class="mt-3 max-w-2xl text-muted-foreground">
    KSA registers every asset id into one global table with <code class="font-mono text-sm">TryAdd</code>.
    When two mods declare the same id, the second one is silently discarded — no error, no log line
    a player will ever find. The part they installed simply is not there.
</p>
<p class="mt-2 max-w-2xl text-muted-foreground">
    Because every archive is parsed at import, this index can answer who else declares an id.
</p>

<form action="/collisions" method="get" class="mt-6 flex max-w-lg gap-2">
    <input name="assetId" type="search" value="@AssetId" placeholder="e.g. FuelTank"
           aria-label="Asset id"
           class="h-9 flex-1 rounded-md border border-input bg-background px-3 font-mono text-sm
                  placeholder:font-sans placeholder:text-muted-foreground focus-visible:outline-2
                  focus-visible:outline-offset-2 focus-visible:outline-ring" />
    <Button Type="submit" Variant="secondary">Look up</Button>
</form>

@if (_error is not null)
{
    <Alert Variant="error" Class="mt-6">@_error</Alert>
}
else if (_lookup is not null)
{
    <Card Class="mt-6" Padded="false"
          Header="@(b => b.AddContent(0, _lookup.AssetId))"
          Description="@(b => b.AddContent(0, Summary))">

        @if (_lookup.DeclaredBy.Count == 0)
        {
            <p class="px-5 py-4 text-sm text-muted-foreground">
                No listed mod declares this id.
            </p>
        }
        else
        {
            <ul class="divide-y divide-border">
                @foreach (var owner in _lookup.DeclaredBy)
                {
                    <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-5 py-3 text-sm">
                        <a href="@($"/mods/{owner.Id}")"
                           class="font-mono font-medium underline-offset-4 hover:underline">@owner.Id</a>
                        <span class="font-mono text-muted-foreground">@owner.Version</span>
                        <code class="ml-auto font-mono text-xs text-muted-foreground">@owner.XmlPath</code>
                    </li>
                }
            </ul>
        }
    </Card>

    @if (_lookup.DeclaredBy.Count > 1)
    {
        <Alert Variant="warning" Title="These mods conflict" Class="mt-4">
            Installing more than one of these means only the first to load registers this id.
            Load order comes from <code class="font-mono">manifest.toml</code>, which the game
            rewrites whenever mods are toggled in-game — so which one wins is not stable.
        </Alert>
    }
}

@code {
    [Parameter] public string? AssetId { get; set; }
    [SupplyParameterFromQuery(Name = "assetId")] public string? QueryAssetId { get; set; }

    private CollisionResult? _lookup;
    private string? _error;

    private string Summary => _lookup!.DeclaredBy.Count switch
    {
        0 => "Not declared by any listed mod",
        1 => "Declared by one mod — no conflict",
        var n => $"Declared by {n} mods — they conflict",
    };

    protected override async Task OnParametersSetAsync()
    {
        _lookup = null;
        _error = null;

        var target = AssetId ?? QueryAssetId;
        if (string.IsNullOrWhiteSpace(target)) return;

        AssetId = target;

        try
        {
            _lookup = await Api.GetCollisionsAsync(target);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _error = "The API did not respond.";
        }
    }
}
