@page "/Error"
@using System.Diagnostics

<PageTitle>Something broke | ksamods.gg</PageTitle>

<div class="mx-auto max-w-md py-16 text-center">
    <p class="font-mono text-sm text-severity-error">500</p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight">Something broke on our side</h1>
    <p class="mt-3 text-sm text-muted-foreground">
        This one's on us, not you. Reloading sometimes helps. If it keeps happening, the
        id below tells us which request went wrong.
    </p>

    @if (ShowRequestId)
    {
        <p class="mt-4 text-xs text-muted-foreground">
            Request id
            <code class="ml-1 rounded bg-muted px-1.5 py-0.5 font-mono text-foreground">@RequestId</code>
        </p>
    }

    <div class="mt-6 flex justify-center gap-3">
        <Button Href="/" Size="sm">Go home</Button>
        <Button Href="/mods" Variant="ghost" Size="sm">Browse mods</Button>
    </div>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
