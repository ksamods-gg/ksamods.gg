@page "/mods/{Id}"
@inject KsaModsApi Api

<PageTitle>@(_mod?.Name ?? Id) | ksamods.gg</PageTitle>

@if (_error is not null)
{
    <Alert Variant="error" Title="Could not load this listing">@_error</Alert>
}
else if (_notFound)
{
    @* Headed, like every other state of this page and like /not-found itself. A miss on a mod id
       is one of the likelier ways to arrive here - old links, renamed mods, a typo in a Discord
       paste - and it was the one state that gave a screen reader nothing to be sent to. *@
    <Card Class="mx-auto max-w-md text-center">
        <h1 class="text-lg font-semibold tracking-tight">This mod isn't here</h1>
        <p class="mt-2 text-sm text-muted-foreground">
            No listing with the id <code class="font-mono">@Id</code>.
        </p>
        <Button Href="/mods" Variant="outline" Size="sm" Class="mt-4">Browse mods</Button>
    </Card>
}
else if (_mod is null)
{
    <p class="text-sm text-muted-foreground">Loading…</p>
}
else if (_mod.IsWithdrawn)
{
    @* Delisted content stays resolvable by id - modlists pin it and dependency graphs reference
       it - but the download is not offered and the reason is stated plainly. *@
    <Card Header="@(builder => { builder.AddContent(0, _mod.Id); })">
        <Alert Variant="warning" Title="This listing has been withdrawn">
            @(_mod.Message ?? "Moderators have withdrawn this listing, so we're not offering its releases.")
            <p class="mt-2">
                That only removes it from this index. Nothing is touched in the
                author's own repository.
            </p>
        </Alert>
    </Card>
}
else
{
    <article>
        @*
            One header object rather than a stack of bands: banner as its lid, icon overlapping the
            seam, identity and actions on the same line underneath. The overlap is what makes it
            read as a single card instead of an image with a title under it.
        *@
        <header class="overflow-hidden rounded-lg border border-border bg-card shadow-card">
            @if (!string.IsNullOrWhiteSpace(_mod.BannerUrl))
            {
                @* Author-hosted, so it may 404 at any time: onerror drops the strip instead of
                   leaving a broken image sitting above the title. *@
                <div class="mod-banner aspect-[5/1] w-full overflow-hidden border-b border-border bg-secondary">
                    <img src="@_mod.BannerUrl" alt="" referrerpolicy="no-referrer"
                         onerror="this.parentElement.remove()"
                         class="h-full w-full object-cover" />
                </div>
            }

            <div class="flex flex-wrap items-start gap-4 p-5">
                @* The overlap is applied by CSS keyed on the banner still being in the DOM, not by
                   a class decided here from BannerUrl. An author-hosted banner can 404, onerror
                   drops the strip, and a server-side guess then leaves the icon pulled 3rem up
                   into empty space above the card with the page showing through behind it. *@
                <ModIcon Id="@_mod.Id" IconUrl="@_mod.IconUrl" Size="lg" Class="mod-icon" />

                <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                        <h1 class="text-[1.75rem] font-bold leading-tight tracking-tight">@_mod.Name</h1>
                        @if (_mod.IsLoader)
                        {
                            @* Next to the name, because the distinction changes what the page is
                               for: this is not something to install because it looks good. *@
                            <Badge Variant="info" Title="Not a mod. Other mods run on top of it.">loader</Badge>
                        }
                    </div>

                    @* The id, verbatim: this is the folder name the game loads it under. *@
                    <code class="mt-1 block font-mono text-sm text-muted-foreground">@_mod.Id</code>

                    @if (_mod.Author is { } author)
                    {
                        <div class="mt-2 flex flex-wrap items-center gap-x-2.5 gap-y-1">
                            <a href="@($"/u/{author.Handle}")"
                               class="inline-flex items-center gap-2 rounded-sm text-sm
                                      text-muted-foreground transition-colors hover:text-foreground
                                      focus-visible:outline-2 focus-visible:outline-offset-2">
                                @if (!string.IsNullOrWhiteSpace(author.AvatarUrl))
                                {
                                    <img src="@author.AvatarUrl" alt="" width="20" height="20"
                                         class="size-5 rounded-full border border-border object-cover"
                                         loading="lazy" referrerpolicy="no-referrer" />
                                }
                                <span>by <span class="font-medium text-foreground">@author.DisplayName</span></span>
                            </a>

                            @if (_mod.AuthorHidden)
                            {
                                @* Only reachable by maintainers and moderators, who are the only
                                   people the API sends an author to on a hidden listing. Marked so
                                   nobody edits a listing believing their name is on it when it is
                                   not, or the other way round. *@
                                <Badge Variant="outline" Title="Only you and the moderators see this.">
                                    hidden from readers
                                </Badge>
                            }
                        </div>
                    }
                    else if (_mod.AuthorHidden)
                    {
                        @* Said rather than left blank. A missing byline reads as an oversight, and
                           somebody wondering whether the site simply lost the author is somebody
                           still thinking about who it is. *@
                        <p class="mt-2 text-sm text-muted-foreground">
                            The author has chosen not to be named.
                        </p>
                    }

                    <p class="mt-2.5 max-w-2xl text-sm leading-relaxed text-muted-foreground">
                        @_mod.Abstract
                    </p>
                </div>

                <div class="flex shrink-0 flex-wrap items-center gap-2">
                    @if (_mod.CanManage)
                    {
                        <Button Href="@($"/mods/{_mod.Id}/manage")" Variant="outline" Size="sm">Manage</Button>
                    }
                    @if (_latest is not null)
                    {
                        <Button Href="@($"/mods/{_mod.Id}/releases/{_latest.Version}")" Size="sm">
                            Get @_latest.Version
                        </Button>
                    }
                </div>
            </div>
        </header>

        @* Only maintainers get told it is a draft. To anyone else who has the link it is simply
           a page, and announcing "this is unlisted" to a stranger tells them nothing useful. *@
        @if (_mod.IsDraft && _mod.CanManage)
        {
            <Alert Variant="info" Title="This listing is a draft" Class="mt-4">
                It doesn't appear in browse or search yet, though anyone with the link can open it.
                <a href="@($"/mods/{_mod.Id}/manage")" class="ml-1 underline underline-offset-4">
                    Publish it
                </a>
                when you're ready.
            </Alert>
        }

        @if (_mod.IsLoader)
        {
            <Alert Variant="info" Title="This is a mod loader" Class="mt-4">
                It isn't a mod in its own right. It's the code other mods run on. Install it
                because something you want has asked for it, and the release page of that mod will
                say which version it needs.
            </Alert>
        }

        @if (_mod.IsDeprecated)
        {
            <Alert Variant="warning" Title="The author has deprecated this mod" Class="mt-4">
                @if (_mod.SupersededBy is not null)
                {
                    <span>
                        It is replaced by
                        <a href="@($"/mods/{_mod.SupersededBy}")" class="underline underline-offset-4">
                            @_mod.SupersededBy
                        </a>, though installing this one still works.
                    </span>
                }
                else
                {
                    <span>It isn't maintained any more, though installing it still works.</span>
                }
            </Alert>
        }

        @*
            Content left, facts right. The right column is what a visitor checks before installing -
            what it needs, what it is, where it came from - and it stays put while the description
            and the release list scroll.
        *@
        <div class="mt-6 flex flex-col gap-6 lg:flex-row lg:gap-8">
            <div class="min-w-0 flex-1 space-y-6">

        @if (_mod.Tags.Count > 0)
        {
            @* The anchor carries the height, not the badge inside it. A bare <a> wrapped around a
               22px pill is a 22px target, and these are a standalone row rather than links inside
               a sentence, so the inline exemption does not apply to them. *@
            <div class="flex flex-wrap gap-1.5">
                @foreach (var tag in _mod.Tags)
                {
                    <a href="@($"/mods?tag={Uri.EscapeDataString(tag)}")"
                       class="inline-flex min-h-6 items-center rounded-sm transition-opacity hover:opacity-80">
                        <Badge Variant="outline">@tag</Badge>
                    </a>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_mod.Description))
        {
            <Card Header="@(b => b.AddContent(0, "About"))">
                @* CommonMark, which is what the field has always held - it was rendered as plain
                   text only because rendering it needs a sanitiser first. SafeMarkdown is that
                   sanitiser: raw HTML never survives the parse, and every link and image URL is
                   checked against a scheme allowlist. Nothing else on this site may pass author
                   input to MarkupString. *@
                <div class="markdown text-sm leading-relaxed">@SafeMarkdown.ToHtml(_mod.Description)</div>
            </Card>
        }

        <Card Padded="false"
              Header="@(b => b.AddContent(0, "Releases"))"
              Description="@(b => b.AddContent(0, $"{_mod.Releases.Count} published"))">

            @if (_mod.Releases.Count == 0)
            {
                <p class="px-5 py-4 text-sm text-muted-foreground">
                    No releases yet. Connect a repository and tag a release to publish one.
                </p>
            }
            else
            {
                <ul class="divide-y divide-border">
                    @foreach (var release in _mod.Releases)
                    {
                        <li class="flex flex-wrap items-center gap-x-3 gap-y-2 px-5 py-3">
                            <a href="@($"/mods/{_mod.Id}/releases/{release.Version}")"
                               class="inline-flex min-h-6 items-center font-mono text-sm font-medium underline-offset-4 hover:underline">
                                @release.Version
                            </a>

                            @if (release.ReleaseStatus != "stable")
                            {
                                <Badge Variant="outline">@Presentation.ReleaseChannel(release.ReleaseStatus)</Badge>
                            }

                            @if (release.Yanked)
                            {
                                @* A yank is the author's statement about one build - distinct from
                                   deprecation and from a moderator delisting. *@
                                <Badge Variant="error" Title="Retracted by the author. Copies you already installed are fine.">
                                    Yanked
                                </Badge>
                            }

                            <PillBadge Value="@Presentation.Validation(release.ValidationState)" />
                            <PillBadge Value="@Presentation.Availability(release.Availability, null)" />

                            <span class="ml-auto text-xs text-muted-foreground">
                                @Presentation.Ago(release.ReleasedAt)
                            </span>
                        </li>
                    }
                </ul>
            }
        </Card>
            </div>

            <aside class="w-full shrink-0 lg:w-72">
                <div class="lg:sticky lg:top-20 space-y-4">
                    @*
                        The title block. On a drawing it sits at the corner of the sheet and answers
                        what you are holding, which revision, and who signed it off, without reading
                        the drawing itself.

                        Here it answers the same question about a mod, and the last row is the one
                        that matters: this site does not host the file, so every guarantee it offers
                        is a claim about a moment in the past. Putting that moment in the furniture
                        is the product's first principle made structural instead of stated.
                    *@
                    <section aria-labelledby="title-block-heading">
                        <h2 id="title-block-heading" class="field-label mb-2 text-muted-foreground">
                            Title block
                        </h2>

                        <dl class="title-block bg-card">
                            <dt>Id</dt>
                            <dd>@_mod.Id</dd>

                            <dt>Type</dt>
                            <dd>@(_mod.Type == "mod-loader" ? "mod-loader" : "mod")</dd>

                            <dt>Licence</dt>
                            <dd>@(_mod.License ?? "not stated")</dd>

                            <dt>Releases</dt>
                            <dd>@_mod.Releases.Count</dd>

                            @if (_latest is not null)
                            {
                                <dt>Latest</dt>
                                <dd>@_latest.Version</dd>
                            }

                            @* The authored bound, and the revision it resolves to. A client
                               compares the revision; a person recognises the string, so both are
                               drawn rather than one standing in for the other. *@
                            @* The bound as written, and the revision it resolves to. A client
                               compares the revision; a person recognises the string. Both are
                               drawn, because neither stands in for the other. *@
                            @if (_mod.GameMin is { Length: > 0 } bound)
                            {
                                <dt>Game min</dt>
                                <dd>
                                    @bound
                                    @if (_latest?.GameMinRevision is { } revision)
                                    {
                                        <span class="text-muted-foreground"> rev @revision</span>
                                    }
                                </dd>
                            }

                            @if (_mod.GameMax is { Length: > 0 } upper)
                            {
                                <dt>Game max</dt>
                                <dd>@upper</dd>
                            }

                            @if (_mod.UpdatedAt is { } updated)
                            {
                                <dt>Updated</dt>
                                <dd>@Presentation.Ago(updated)</dd>
                            }

                            @*
                                The row the whole block is for. Everything above is what the author
                                said; this is what we checked and when we checked it. The site never
                                held the file, so a guarantee without its moment is worth nothing —
                                and a stale timestamp shown honestly is worth more than a green tick
                                that means whatever the reader hopes.
                            *@
                            <dt>Verified</dt>
                            <dd>
                                @if (_latest?.LastVerifiedAt is { } checkedAt)
                                {
                                    @Presentation.Ago(checkedAt)
                                }
                                else
                                {
                                    <span class="text-muted-foreground">never</span>
                                }
                            </dd>
                        </dl>
                    </section>

                    @* Said on every listing that offers a download, not tucked into a policy
                           page. The site checks packaging; it cannot check intent, and a visitor
                           deciding whether to run somebody's assembly deserves that in front of
                           them rather than behind a link. *@
                    <p class="mt-4 border-t border-border pt-3 text-xs leading-relaxed text-muted-foreground">
                        This download comes straight from the author's own repository, not from us.
                        We never had a copy. All we kept was the link and a hash of the file we
                        checked.
                    </p>

                        @* Under the disclaimer rather than up beside Download. Somebody who needs
                           this has already decided something is wrong, and putting it level with
                           the install button says the site expects its own catalogue to be bad. *@
                    <div class="mt-3">
                        <ReportButton SubjectKind="mod" SubjectId="@_mod.Id" Noun="mod" />
                    </div>
                </div>
            </aside>
        </div>
    </article>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private ModDetail? _mod;
    private ReleaseSummary? _latest;
    private bool _notFound;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _mod = null;
        _error = null;
        _notFound = false;

        try
        {
            _mod = await Api.GetModAsync(Id);
            _notFound = _mod is null;

            // "Latest" deliberately skips yanked and non-stable builds: it is the version the
            // page recommends, and recommending a retracted build would be actively harmful.
            _latest = _mod?.Releases
                .FirstOrDefault(r => !r.Yanked && r.ReleaseStatus == "stable");
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _error = "The API didn't respond.";
        }
    }
}
