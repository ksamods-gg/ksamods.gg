@namespace KsaMods.Web.Components.Ui

@*
    The mark is a body with one satellite on an inclined orbit, which is the shape of the game
    this site serves and also, read another way, the shape of what the site does: one thing in
    the middle with everything else in a fixed relationship around it.

    Drawn rather than set in type because a wordmark made only of letters is the thing every
    unbranded site has. It inherits currentColor so it works on any surface and in both themes.
*@

<a href="/" class="@Cx.Of("group inline-flex min-h-6 items-baseline gap-2", Class)" aria-label="ksamods.gg, home">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
         class="@(Compact ? "size-4" : "size-[1.15rem]") shrink-0 translate-y-[0.15em] text-primary">
        <g transform="rotate(-28 12 12)">
            <ellipse cx="12" cy="12" rx="10.25" ry="4.6" stroke="currentColor" stroke-width="1.4" opacity="0.5" />
            <circle cx="22.25" cy="12" r="1.7" fill="currentColor" />
        </g>
        <circle cx="12" cy="12" r="3.4" fill="currentColor" />
    </svg>

    <span class="font-display text-[1.0625rem] font-bold leading-none tracking-tight">
        ksamods<span class="text-muted-foreground">.gg</span>
    </span>
</a>

@code {
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string? Class { get; set; }
}
