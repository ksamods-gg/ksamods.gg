@namespace KsaMods.Web.Components.Ui

@if (Href is not null)
{
    @* Rendered as a link when it navigates, as a button when it acts. A "button" that navigates
       breaks middle-click, open-in-new-tab and the browser's own affordances. *@
    <a href="@Href" class="@Classes" @attributes="Extra">@ChildContent</a>
}
else
{
    @*
        Pending says the same thing three ways, because the ring said it only one way and that way
        was motion.

        app.css collapses every animation to 0.01ms under prefers-reduced-motion, which turned this
        into a static circle: the one control on the page whose entire job is to say "still working"
        went silent for the people who asked for less movement. The ring is now the supplement
        rather than the signal - it is removed outright under that query instead of being frozen
        into an artifact that reads as a rendering fault.

        What carries the state instead is the label, which changes on every device and in every
        motion setting; `aria-busy`, which is what a screen reader listens for and which no amount
        of spinning ever conveyed; and the disabled state, which is now the component's own doing
        rather than a second parameter each caller had to remember to pair up.
    *@
    <button type="@Type" class="@Classes" disabled="@(Disabled || Pending)"
            aria-busy="@(Pending ? "true" : null)" @attributes="Extra">
        @if (Pending)
        {
            <span class="size-4 shrink-0 animate-spin rounded-full border-2 border-current
                         border-t-transparent motion-reduce:hidden"
                  aria-hidden="true"></span>
        }

        @if (Pending && PendingLabel is not null)
        {
            @PendingLabel
        }
        else if (Pending)
        {
            @* The fallback when a caller gave no pending label: still a visible change, still not
               motion. Hidden from assistive tech because aria-busy already said it, and a name that
               mutates mid-press is worse than one that holds still.

               Wrapped with the label rather than left beside it, because this button is a flex row
               with a gap and a bare sibling becomes a flex item of its own - which set the ellipsis
               eight pixels adrift and made it read as its own word. *@
            <span>@ChildContent<span aria-hidden="true">…</span></span>
        }
        else
        {
            @ChildContent
        }
    </button>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>primary | secondary | outline | ghost | destructive | link</summary>
    [Parameter] public string Variant { get; set; } = "primary";

    /// <summary>sm | md | lg | icon</summary>
    [Parameter] public string Size { get; set; } = "md";

    [Parameter] public string? Href { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// An action is in flight. Disables the button on its own - a pending button that can still be
    /// pressed is a double submission waiting to happen, and that should not depend on every caller
    /// remembering to pass <see cref="Disabled"/> as well.
    /// </summary>
    [Parameter] public bool Pending { get; set; }

    /// <summary>
    /// What the button says while <see cref="Pending"/>: "Saving…" rather than "Save changes".
    /// This is the part of the pending state that survives reduced motion, so it is worth writing
    /// per action. Without it the label keeps its own words and gains an ellipsis.
    /// </summary>
    [Parameter] public string? PendingLabel { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Extra { get; set; }

    private const string Base =
        "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md " +
        "font-medium transition-colors duration-150 disabled:pointer-events-none " +
        "disabled:opacity-50 focus-visible:outline-2 focus-visible:outline-offset-2 " +
        "focus-visible:outline-ring";

    private string Classes => Cx.Of(Base, VariantClasses, SizeClasses, Class);

    private string VariantClasses => Variant switch
    {
        "secondary" => "bg-secondary text-secondary-foreground hover:bg-secondary/70",
        "outline" => "border border-input bg-transparent hover:border-primary/60 hover:text-primary",
        "ghost" => "text-muted-foreground hover:bg-accent hover:text-foreground",
        "destructive" => "bg-destructive text-destructive-foreground hover:bg-destructive/90",
        "link" => "text-primary underline-offset-4 hover:underline",
        // Hover is a token, not a filter. A brightness filter lightened the fill in both themes,
        // which is the right direction on the dark ground and the wrong one on the light: it was
        // taking the light primary button from 4.73:1 down to 4.02:1 at exactly the moment
        // somebody had decided to press it. Each theme now names the colour its own hover moves
        // toward. (Naming the old utility here would have been enough for Tailwind to scan the
        // comment and emit it again - it reads source as text, not as code.)
        _ => "bg-primary text-primary-foreground hover:bg-primary-hover",
    };

    // Slightly shorter and tighter than the shadcn defaults, and labels sit at 13px rather than
    // 14px. Controls this size read as instrument chrome next to the condensed headings instead
    // of competing with them.
    private string SizeClasses => Size switch
    {
        "sm" => "h-8 px-3 text-xs",
        "lg" => "h-11 px-6 text-sm",
        "icon" => "size-8",
        _ => "h-9 px-3.5 text-[0.8125rem]",
    };
}
