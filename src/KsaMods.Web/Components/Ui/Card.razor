@namespace KsaMods.Web.Components.Ui

<div class="@Cx.Of("rounded-lg border border-border bg-card text-card-foreground", Class)">
    @if (Header is not null)
    {
        @* The header is an eyebrow, not a title: it labels the panel the way a section on a
           technical drawing is labelled, and leaves the emphasis to the content inside. *@
        <div class="flex items-start justify-between gap-4 border-b border-border px-5 py-3.5">
            <div class="min-w-0">
                <h2 class="eyebrow text-muted-foreground">@Header</h2>
                @if (Description is not null)
                {
                    <p class="mt-1 font-mono text-xs text-muted-foreground">@Description</p>
                }
            </div>
            @if (Actions is not null)
            {
                <div class="flex shrink-0 items-center gap-2">@Actions</div>
            }
        </div>
    }
    <div class="@Cx.Of(Padded ? "px-5 py-4" : null, BodyClass)">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Off when the body is a table or list that should meet the card's edges.</summary>
    [Parameter] public bool Padded { get; set; } = true;

    [Parameter] public string? Class { get; set; }
    [Parameter] public string? BodyClass { get; set; }
}
