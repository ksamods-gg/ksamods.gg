{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "exclude": ["**/.env", "**/.env.*"],
  "packages": {
    "node": "22",
    "bun": "1.4.2"
  },
  "caches": {
    "bun-install": {
      "directory": "/root/.bun/install/cache",
      "type": "shared"
    }
  },
  "steps": {
    "install": {
      "commands": [
        { "src": "patches", "dest": "patches" },
        {
          "cmd": "bun install --frozen-lockfile --ignore-scripts",
          "customName": "Install workspace dependencies"
        }
      ],
      "caches": ["bun-install"]
    },
    "build": {
      "commands": [
        {
          "cmd": "bun run --cwd packages/server generate",
          "customName": "Generate Prisma client"
        }
      ]
    }
  },
  "deploy": {
    "startCommand": "bun run --cwd packages/server start"
  }
}
