DATABASE_URL="postgresql://ksamods:ksamods@localhost:5432/ksamods?schema=public"

BETTER_AUTH_SECRET=""  # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3001"

# https://discord.com/developers/applications -> OAuth2
# redirect: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# https://github.com/settings/developers -> OAuth Apps
# callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""

# Comma separated Discord user ids that are always admin, regardless of the
# role column. Break-glass bootstrap so a fresh database always has an arbiter.
ADMIN_DISCORD_IDS=""

# Where listing submissions open their pull request. The base branch is a test
# branch until the flow is proven; point it at main to go live.
CONTENT_INDEX_REPO="KSAModding/content-index"
CONTENT_INDEX_BASE_BRANCH="automation-test"
# Set to false to turn the submission form off without a deploy.
SUBMISSIONS_ENABLED="true"
