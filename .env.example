APP_NAME="ksamods.gg"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Named in the privacy policy and terms of use.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_COUNTRY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=fsn1
AWS_BUCKET=
AWS_ENDPOINT=https://fsn1.your-objectstorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# The share host for vehicles and saves (config/share.php). In development the public disk
# serves the files (php artisan storage:link); production uses the s3 disk on Hetzner.
SHARE_DISK=public
SHARE_PUBLIC_URL=
# php artisan share:key
SHARE_SIGNING_KEY=
# The bot GitHub user: a classic token with public_repo, and its numeric id.
SHARE_BOT_TOKEN=
SHARE_BOT_ID=
# A test repository until ksamods is registered in hosts.toml, then KSAModding/content-index.
SHARE_AUTHORED_REPOSITORY=
SHARE_ABUSE_EMAIL=abuse@ksamods.gg
# Internet Archive mirrors (https://archive.org/account/s3.php); empty turns mirroring off.
IA_ACCESS_KEY=
IA_SECRET_KEY=
IA_COLLECTION=opensource_media
SHARE_DISCORD_URL=

VITE_APP_NAME="${APP_NAME}"

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
