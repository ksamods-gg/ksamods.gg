# Shell scripts and Dockerfiles run inside Linux containers. If git checks them out with CRLF on
# a Windows clone, the shebang becomes "#!/bin/sh\r" and the kernel reports
# "bad interpreter: no such file or directory" — an error that names a file which plainly exists.
* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
*.sql       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.zip binary
